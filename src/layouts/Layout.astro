---
import '../styles/fonts.css';
import '../styles/minimal-light.css';
import '../styles/paper-figures.css';
import AcademicProfile from '../components/AcademicProfile.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { getLocale, localizePath, text } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = (en: string, vi: string) => text(locale, en, vi);
const href = (path: string) => localizePath(path, locale);
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title, description = t('Binh Minh Tran works on graph and multimodal learning for biomedical research, with interests in computational RNA biology, spatial omics, and cancer AI.', 'Trần Bình Minh nghiên cứu các phương pháp học trên đồ thị và học đa phương thức trong y sinh, tập trung vào sinh học RNA tính toán, dữ liệu phân tử theo không gian và ứng dụng trí tuệ nhân tạo trong nghiên cứu ung thư.'), noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${t("Binh Minh Tran", "Trần Bình Minh")}` : t('Binh Minh Tran — Biomedical AI & Computational Biology', 'Trần Bình Minh — Trí tuệ nhân tạo y sinh và Sinh học tính toán');
const nav = [{ href: '/', label: t('Home', 'Trang chủ') }, { href: '/research/', label: t('Research', 'Nghiên cứu') }, { href: '/publications/', label: t('Publications', 'Công bố') }, { href: '/about/', label: t('About & CV', 'Giới thiệu và CV') }].map(item => ({ ...item, href: href(item.href) }));
const path = Astro.url.pathname;
const origin = Astro.site?.origin;
const canonical = !noindex && origin && !origin.includes('example.invalid') ? new URL(path, origin).href : undefined;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fcfbf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171a1f" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Apply a saved Light/Dark choice before the first paint. With no saved
      // choice the site follows the system setting through CSS.
      (function () {
        var root = document.documentElement;
        root.setAttribute('data-js', '');
        try {
          var theme = localStorage.getItem('theme');
          if (theme !== 'light' && theme !== 'dark') return;
          root.setAttribute('data-theme', theme);
          document.querySelectorAll('meta[name="theme-color"]').forEach(function (meta) {
            meta.setAttribute('data-default', meta.content);
            meta.content = theme === 'dark' ? '#171a1f' : '#fcfbf7';
          });
        } catch (error) {}
      })();
    </script>
    <meta name="author" content={t(profile.name, "Trần Bình Minh")} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /><meta property="og:image" content={new URL('/assets/social-card.png', origin).href} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={t("Binh Minh Tran — Graph and multimodal learning for biomedical research", "Trần Bình Minh — Học trên đồ thị và học đa phương thức cho nghiên cứu y sinh")} /></>}
    <meta property="og:locale" content={locale === 'vi' ? 'vi_VN' : 'en_AU'} />
    <meta property="og:locale:alternate" content={locale === 'vi' ? 'en_AU' : 'vi_VN'} />
    {canonical && <>{(['en', 'vi'] as const).map(language => <link rel="alternate" hreflang={language} href={new URL(localizePath(path, language), origin).href} />)}<link rel="alternate" hreflang="x-default" href={new URL(localizePath(path, 'en'), origin).href} /></>}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/assets/fonts/crimson-pro-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{t("Skip to content", "Đến nội dung chính")}</a>
    <div class="minimal-wrapper">
      <div class="minimal-sidebar">
        <AcademicProfile />
        <nav id="primary-navigation" class="primary-nav" aria-label={t('Main navigation', 'Điều hướng chính')}>
          {nav.map(item => <a href={item.href} aria-current={item.href === href('/') ? path === href('/') ? 'page' : undefined : path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <nav class="language-switch" aria-label={t('Language', 'Ngôn ngữ')}>
          <a href={noindex ? '/' : localizePath(path, 'en')} lang="en" hreflang="en" aria-current={locale === 'en' ? 'true' : undefined} data-language="en">English</a>
          <span aria-hidden="true">/</span>
          <a href={noindex ? '/vi/' : localizePath(path, 'vi')} lang="vi" hreflang="vi" aria-current={locale === 'vi' ? 'true' : undefined} data-language="vi">Tiếng Việt</a>
        </nav>
        <div class="theme-switch" role="group" aria-label={t('Colour theme', 'Chế độ màu')}>
          <button type="button" data-theme-choice="auto" aria-pressed="true" title={t('Follow the system setting', 'Theo cài đặt của hệ thống')}><Icon name="contrast" size={13} />{t('Auto', 'Tự động')}</button>
          <span aria-hidden="true">/</span>
          <button type="button" data-theme-choice="light" aria-pressed="false"><Icon name="sun" size={13} />{t('Light', 'Sáng')}</button>
          <span aria-hidden="true">/</span>
          <button type="button" data-theme-choice="dark" aria-pressed="false"><Icon name="moon" size={13} />{t('Dark', 'Tối')}</button>
        </div>
      </div>
      <div class="minimal-content">
        <main id="main"><slot /></main>
        <footer class="site-footer" id="contact">
          <p class="theme-credit">© 2026 {t("Binh Minh Tran", "Trần Bình Minh")} · {t('Design adapted from', 'Giao diện dựa trên')} <a href="https://github.com/yaoyao-liu/minimal-light" target="_blank" rel="noopener noreferrer">Minimal Light</a>; {t('publication list after', 'danh sách công bố theo mẫu của')} <a href="https://github.com/jonbarron/jonbarron_website" target="_blank" rel="noopener noreferrer">Jon Barron</a>.</p>
        </footer>
      </div>
    </div>
    <script>
      // Keep section anchors when switching between equivalent language pages.
      document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach(link => {
        if (location.hash) link.hash = location.hash;
        window.addEventListener('hashchange', () => { link.hash = location.hash; });
      });

      // Colour theme switch: Auto follows the system; Light and Dark are remembered.
      type ThemeChoice = 'auto' | 'light' | 'dark';
      const themeColors = { light: '#fcfbf7', dark: '#171a1f' };
      const savedTheme = (): ThemeChoice => {
        try {
          const theme = localStorage.getItem('theme');
          return theme === 'light' || theme === 'dark' ? theme : 'auto';
        } catch {
          return 'auto';
        }
      };
      const applyTheme = (choice: ThemeChoice) => {
        const root = document.documentElement;
        if (choice === 'auto') delete root.dataset.theme;
        else root.dataset.theme = choice;
        document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach(meta => {
          meta.dataset.default ??= meta.content;
          meta.content = choice === 'auto' ? meta.dataset.default : themeColors[choice];
        });
        document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach(button => {
          button.setAttribute('aria-pressed', String(button.dataset.themeChoice === choice));
        });
      };
      applyTheme(savedTheme());
      document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach(button => button.addEventListener('click', () => {
        const choice = (button.dataset.themeChoice || 'auto') as ThemeChoice;
        try {
          if (choice === 'auto') localStorage.removeItem('theme');
          else localStorage.setItem('theme', choice);
        } catch {}
        applyTheme(choice);
      }));
      // Keep other open tabs of the site in step.
      window.addEventListener('storage', event => { if (event.key === 'theme') applyTheme(savedTheme()); });
    </script>
  </body>
</html>
