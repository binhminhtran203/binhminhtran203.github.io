---
import '../styles/global.css';
import '../styles/profile.css';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title, description = 'Binh Minh Tran works on graph and multimodal learning for biomedical research, with interests in computational RNA biology, spatial omics, and cancer AI.', noindex = false } = Astro.props;
const pageTitle = title ? `${title} — Binh Minh Tran` : 'Binh Minh Tran — Biomedical AI & Computational Biology';
const nav = [{ href: '/', label: 'Home' }, { href: '/research/', label: 'Research' }, { href: '/publications/', label: 'Publications' }, { href: '/about/', label: 'About & CV' }];
const path = Astro.url.pathname;
const origin = Astro.site?.origin;
const canonical = !noindex && origin && !origin.includes('example.invalid') ? new URL(path, origin).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="author" content={profile.name} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /><meta property="og:image" content={new URL('/assets/social-card.png', origin).href} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Binh Minh Tran — Graph and multimodal learning for biomedical research" /></>}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/assets/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="Binh Minh Tran home"><span>Binh Minh Tran<span class="brand-subtitle">Biomedical AI & computational biology</span></span></a>
        <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-navigation"><span></span><span></span></button>
        <nav id="primary-navigation" class="primary-nav" aria-label="Main navigation">
          {nav.map(item => <a href={item.href} aria-current={item.href === '/' ? path === '/' ? 'page' : undefined : path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}
          <a class="nav-contact" href="#contact">Contact <Icon name="mail" size={15} /></a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer" id="contact">
      <div class="container">
        <div class="contact-grid">
          <div><h2>Contact</h2><p>For research enquiries and academic collaboration.</p><a class="email-link" href={`mailto:${profile.email}`}>{profile.email} <Icon name="mail" size={16} /></a></div>
          <nav class="contact-links" aria-label="Contact and academic profiles"><a href={profile.scholar} target="_blank" rel="noopener noreferrer">Google Scholar</a><a href={profile.orcid} target="_blank" rel="noopener noreferrer">ORCID</a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a href={profile.cv} target="_blank" rel="noopener noreferrer">Curriculum vitae</a></nav>
        </div>
        <div class="footer-bottom"><span>© 2026 Binh Minh Tran</span><span>Sydney & Canberra, Australia</span><span>Updated {profile.updated}</span></div>
      </div>
    </footer>
    <script>
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('.primary-nav');
      function closeMenu() { menu?.setAttribute('aria-expanded', 'false'); menu?.setAttribute('aria-label', 'Open navigation'); nav?.classList.remove('is-open'); }
      menu?.addEventListener('click', () => { const open = menu.getAttribute('aria-expanded') !== 'true'; menu.setAttribute('aria-expanded', String(open)); menu.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation'); nav?.classList.toggle('is-open', open); });
      nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', event => { if(event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') { closeMenu(); menu.focus(); } });
      document.addEventListener('click', event => { if(event.target instanceof Node && !document.querySelector('.site-header')?.contains(event.target)) closeMenu(); });
    </script>
  </body>
</html>
