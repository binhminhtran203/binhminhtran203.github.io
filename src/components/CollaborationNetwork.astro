---
// The co-author network at the foot of the Publications page. The drawing is
// laid out at build time (src/data/collaborators.ts) from the same records as
// the list above, so a new paper updates it on the next build. Two drawings
// ship: a wide one, and a tall one for phones. A short script highlights a
// co-author's links and names the joint works.
import publications from '../data/publications.json';
import translationData from '../data/publications.vi.json';
import { buildNetwork, layoutNetwork } from '../data/collaborators';
import { getLocale, text } from '../i18n';

interface Translation { title: string; venue?: string; note?: string; }
const locale = getLocale(Astro.url.pathname);
const t = (en: string, vi: string) => text(locale, en, vi);
const translations = translationData as Record<string, Translation>;
const network = buildNetwork(publications);
const drawings = [
  { name: 'wide', width: 650, height: 430, fontSize: 12.5 },
  { name: 'tall', width: 360, height: 540, fontSize: 12 },
].map(size => ({ ...size, ...layoutNetwork(network, size) }));
const coauthors = network.people
  .filter(person => !person.self)
  .sort((a, b) => b.works.length - a.works.length || a.name.localeCompare(b.name));

// Joint works in the order of the list above: conference papers, journal
// articles, then manuscripts under review.
const order = ['C', 'J', 'M'].flatMap(prefix => publications.filter(paper => paper.id.startsWith(prefix)).map(paper => paper.id));
const papers = new Map(publications.map(paper => [paper.id, paper]));
const work = (id: string) => {
  const paper = papers.get(id)!;
  const translation = locale === 'vi' ? translations[id] : undefined;
  const status = paper.status === 'accepted' ? t('accepted', 'đã được chấp nhận')
    : paper.status === 'review' ? (translation?.note ?? paper.note ?? t('Under review', 'Đang phản biện')).toLowerCase()
    : '';
  return { id, venue: translation?.venue ?? paper.venue, status, title: translation?.title ?? paper.title };
};
const joint = (n: number) => t(`${n} joint ${n === 1 ? 'work' : 'works'}`, `${n} công trình chung`);
---
<section class="container collaboration-section" id="collaboration-network" aria-labelledby="collaboration-network-title" data-network>
  <h2 id="collaboration-network-title">{t('Collaboration network', 'Mạng lưới cộng tác')}</h2>
  <p class="network-lead">{t(
    `My co-authors on the ${publications.length} works above, including manuscripts under review. A larger, darker circle means more joint works, and a line joins two people who wrote a work together. Co-authors who also worked with one another sit side by side.`,
    `Các đồng tác giả của tôi trong ${publications.length} công trình ở trên, kể cả các bản thảo đang phản biện. Vòng tròn càng lớn và càng đậm thì số công trình chung càng nhiều; đường nối hai người là họ đã cùng viết một công trình. Những đồng tác giả cũng làm việc với nhau được xếp cạnh nhau.`)}</p>
  <figure class="network-figure">
    {drawings.map(drawing => (
      <svg class={`network-graph network-graph-${drawing.name}`} viewBox={drawing.viewBox} font-size={drawing.fontSize} role="img" aria-label={t(`Network of my ${coauthors.length} co-authors; the list below names each one with the number of joint works.`, `Mạng lưới ${coauthors.length} đồng tác giả của tôi; danh sách bên dưới ghi tên từng người và số công trình chung.`)}>
        <g class="network-ties">
          {drawing.ties.map(tie => <path class:list={['network-tie', { 'network-tie-self': tie.self }]} d={tie.path} data-a={tie.a} data-b={tie.b} stroke-width={tie.self ? 1.1 + 0.75 * (tie.works.length - 1) : 0.8 + 0.5 * (tie.works.length - 1)} />)}
        </g>
        {drawing.people.map(person => (
          <g class:list={['network-person', { 'network-self': person.self }]} data-person={person.key} data-works={Math.min(person.works.length, 5)} transform={`translate(${person.x} ${person.y})`}>
            <circle r={person.r} />
            <text x={person.label.x} y={person.label.y} text-anchor={person.label.anchor}>{person.name}</text>
          </g>
        ))}
      </svg>
    ))}
    <figcaption class="network-details" aria-live="polite">
      <p data-detail="">{t(
        `${coauthors.length} co-authors across ${publications.length} works. Select a circle or a name below to see the joint works.`,
        `${coauthors.length} đồng tác giả trong ${publications.length} công trình. Chọn một vòng tròn hoặc một tên bên dưới để xem các công trình chung.`)}</p>
      {coauthors.map(person => (
        <p data-detail={person.key} hidden>
          <strong>{person.name}</strong>: {joint(person.works.length)} —{' '}
          {order.filter(id => person.works.includes(id)).map(work).map((item, i) => <>{i > 0 && ' · '}<a href={`#paper-${item.id}`} title={item.title}>{item.venue}</a>{item.status && ` (${item.status})`}</>)}
        </p>
      ))}
    </figcaption>
  </figure>
  <p class="network-list-label">{t('Co-authors, by number of joint works', 'Đồng tác giả, xếp theo số công trình chung')}</p>
  <ul class="network-coauthors">
    {coauthors.map(person => (
      <li><button type="button" data-person={person.key} aria-pressed="false" aria-label={`${person.name}, ${joint(person.works.length)}`}>{person.name}<span class="network-count" aria-hidden="true">{person.works.length}</span></button></li>
    ))}
  </ul>
</section>
<script>
  // Highlight a co-author with their links: point at a circle or a name with a
  // mouse, or select one (select it again, press Escape or click the empty
  // drawing to clear). The caption names the joint works.
  const network = document.querySelector<HTMLElement>('[data-network]');
  if (network) {
    const people = [...network.querySelectorAll<SVGGElement>('.network-person')];
    const ties = [...network.querySelectorAll<SVGPathElement>('.network-tie')];
    const details = [...network.querySelectorAll<HTMLElement>('[data-detail]')];
    const buttons = [...network.querySelectorAll<HTMLButtonElement>('button[data-person]')];
    const neighbours = new Map<string, Set<string>>();
    for (const tie of ties) {
      const { a = '', b = '' } = tie.dataset;
      neighbours.set(a, (neighbours.get(a) ?? new Set()).add(b));
      neighbours.set(b, (neighbours.get(b) ?? new Set()).add(a));
    }
    let selected = '';
    const show = (key: string) => {
      const near = neighbours.get(key);
      network.toggleAttribute('data-active', Boolean(key));
      for (const person of people) {
        const own = person.dataset.person || '';
        person.classList.toggle('is-lit', Boolean(key) && (own === key || Boolean(near?.has(own))));
        person.classList.toggle('is-current', Boolean(key) && own === key);
      }
      for (const tie of ties) tie.classList.toggle('is-lit', Boolean(key) && (tie.dataset.a === key || tie.dataset.b === key));
      for (const detail of details) detail.hidden = detail.dataset.detail !== key;
    };
    const select = (key: string) => {
      selected = selected === key ? '' : key;
      for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset.person === selected));
      show(selected);
    };
    const preview = (element: Element, key: string) => {
      element.addEventListener('pointerenter', event => { if ((event as PointerEvent).pointerType === 'mouse') show(key); });
      element.addEventListener('pointerleave', event => { if ((event as PointerEvent).pointerType === 'mouse') show(selected); });
    };
    for (const person of people) {
      // B. M. Tran links to everyone, so that circle only clears a selection.
      const key = person.classList.contains('network-self') ? '' : person.dataset.person || '';
      preview(person, key);
      person.addEventListener('click', event => { event.stopPropagation(); select(key || selected); });
    }
    for (const button of buttons) {
      const key = button.dataset.person || '';
      preview(button, key);
      button.addEventListener('click', () => select(key));
    }
    network.querySelectorAll('.network-graph').forEach(svg => svg.addEventListener('click', () => { if (selected) select(selected); }));
    network.addEventListener('keydown', event => { if (event.key === 'Escape' && selected) select(selected); });
  }
</script>
<style>
  .collaboration-section { margin-top: 34px; padding-top: 26px; border-top: 1px solid var(--line); }
  .network-figure { margin: 0 0 20px; }
  .network-graph { display: block; width: 100%; height: auto; font-family: var(--serif); }
  .network-graph-tall { display: none; max-width: 440px; margin: 0 auto; }
  @media (max-width: 549px) {
    .network-graph-wide { display: none; }
    .network-graph-tall { display: block; }
  }
  .network-tie { fill: none; stroke: var(--muted); stroke-opacity: .2; stroke-linecap: round; transition: opacity .15s, stroke-opacity .15s; }
  .network-tie-self { stroke: var(--link); stroke-opacity: .4; }
  .network-person { transition: opacity .15s; }
  .network-person:not(.network-self) { cursor: pointer; }
  .network-person circle { fill: var(--link); stroke: var(--paper); stroke-width: 1.5px; }
  .network-person[data-works="1"] circle { fill: color-mix(in srgb, var(--link) 48%, var(--paper)); }
  .network-person[data-works="2"] circle { fill: color-mix(in srgb, var(--link) 62%, var(--paper)); }
  .network-person[data-works="3"] circle { fill: color-mix(in srgb, var(--link) 76%, var(--paper)); }
  .network-person[data-works="4"] circle { fill: color-mix(in srgb, var(--link) 88%, var(--paper)); }
  .network-self circle { fill: var(--heading); }
  .network-person text { fill: var(--ink); stroke: var(--paper); stroke-width: 3.5px; stroke-linejoin: round; paint-order: stroke; }
  .network-self text, .network-person.is-current text { font-weight: 600; fill: var(--strong); }
  [data-network][data-active] .network-person:not(.is-lit), [data-network][data-active] .network-tie:not(.is-lit) { opacity: .14; }
  [data-network][data-active] .network-tie.is-lit { stroke-opacity: .85; }
  .network-person.is-current circle { stroke: var(--strong); stroke-width: 2px; }
  .network-details { min-height: 2.9em; margin: 12px 0 0; font-size: 14px; line-height: 1.45; color: var(--muted); }
  .network-details p { margin: 0; }
  .network-details a { text-decoration: underline; text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .network-details a:hover { text-decoration-color: currentColor; }
  .network-list-label { font-size: 13px; color: var(--muted); margin: 0 0 8px; }
  .network-coauthors { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .network-coauthors button { display: inline-flex; align-items: baseline; gap: 6px; min-height: 34px; padding: 5px 9px; border: 1px solid var(--line); background: transparent; color: var(--ink); font-size: 13.5px; line-height: 1.3; }
  .network-coauthors button:hover { border-color: var(--link); color: var(--link); }
  .network-coauthors button[aria-pressed="true"] { border-color: var(--heading); color: var(--heading); }
  .network-count { font-size: 12px; color: var(--muted); }
  @media (max-width: 480px) { .network-coauthors button { min-height: 44px; } }
  @media (prefers-reduced-motion: reduce) { .network-tie, .network-person { transition: none; } }
  @media print { .network-details, .network-list-label, .network-coauthors { display: none; } }
</style>
