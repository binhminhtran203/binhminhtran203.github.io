---
import { getLocale, localizePath, text } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = (en: string, vi: string) => text(locale, en, vi);
interface Props { caption?: boolean; }
const { caption = true } = Astro.props;
---
<figure class="portrait">
  <div class="portrait-frame">
    <img src="/assets/binh-minh-tran-portrait.png" alt={t("Portrait of Trần Bình Minh", "Ảnh chân dung Trần Bình Minh")} width="472" height="709" loading="eager" decoding="async" fetchpriority="high" />
  </div>
  {caption && <figcaption><span>Trần Bình Minh</span></figcaption>}
</figure>
