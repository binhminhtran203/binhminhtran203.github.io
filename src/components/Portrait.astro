---
import { getLocale, localizePath, text } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = (en: string, vi: string) => text(locale, en, vi);
interface Props { caption?: boolean; }
const { caption = true } = Astro.props;
---
<figure class="portrait">
  <div class="portrait-frame">
    <img src="/assets/binh-minh-tran-portrait.png" alt={t("Portrait of Binh Minh Tran", "Ảnh chân dung Binh Minh Tran")} width="472" height="709" loading="eager" decoding="async" fetchpriority="high" />
  </div>
  {caption && <figcaption><span>Binh Minh Tran</span><span>{t("Sydney & Canberra, Australia", "Sydney & Canberra, Úc")}</span></figcaption>}
</figure>
