---
import { getLocale, localizePath, text } from '../i18n';
import Portrait from './Portrait.astro';
import { profile } from '../data/profile';
const locale = getLocale(Astro.url.pathname);
const t = (en: string, vi: string) => text(locale, en, vi);
const isHome = localizePath(Astro.url.pathname, 'en') === '/';
---
<aside class="academic-profile" aria-label={t("Academic profile and contact details", "Hồ sơ học thuật và thông tin liên hệ")}>
  <a class="profile-home" href={localizePath('/', locale)} aria-label={t("Binh Minh Tran home", "Trang chủ Trần Bình Minh")}><Portrait caption={false} /></a>
  {isHome ? <h1 class="academic-profile-name">{t("Binh Minh Tran", "Trần Bình Minh")}</h1> : <p class="academic-profile-name">{t("Binh Minh Tran", "Trần Bình Minh")}</p>}
  <p class="academic-profile-field">{t("Biomedical AI · Computational biology", "Trí tuệ nhân tạo y sinh · Sinh học tính toán")}</p>
  <div class="academic-appointments">
    <p>
      <strong>{t("Visiting Researcher", "Nghiên cứu viên khách mời")}</strong>
      <span class="appointment-institution">{t("Australian National University", "Đại học Quốc gia Australia")}</span>
      <span class="appointment-note">{t("Centre for Computational Biomedical Sciences", "Trung tâm Khoa học Y sinh Tính toán")}</span>
      <span class="appointment-note">{t("John Curtin School of Medical Research", "Trường Nghiên cứu Y khoa John Curtin")}</span>
    </p>
    <p>
      <strong>{t("Honour Research Student", "Sinh viên nghiên cứu chương trình cử nhân danh dự")}</strong>
      <span class="appointment-institution">{t("The University of Sydney", "Đại học Sydney")}</span>
      <span class="appointment-note">{t("Bachelor of Advanced Computing", "Cử nhân Khoa học Máy tính nâng cao (danh dự)")}</span>
    </p>
  </div>
  <a class="profile-email" href={`mailto:${profile.email}`}>{profile.email}</a>
  <nav class="social-icons" aria-label={t("Academic profiles and CV", "Hồ sơ học thuật và CV")}>
    <a href={profile.scholar} target="_blank" rel="noopener noreferrer" aria-label="Google Scholar" title="Google Scholar"><svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 9l10-6 10 6-10 6L2 9zm4 3v5c4 3 8 3 12 0v-5M22 9v9" /></svg></a>
    <a href={profile.cv} target="_blank" rel="noopener noreferrer" aria-label={t("Curriculum vitae (PDF)", "CV tiếng Anh (PDF)")} title={t("Curriculum vitae (PDF)", "CV tiếng Anh (PDF)")}><span class="social-cv" aria-hidden="true">CV</span></a>
    <a href={profile.orcid} target="_blank" rel="noopener noreferrer" aria-label="ORCID" title="ORCID"><span class="social-orcid" aria-hidden="true">iD</span></a>
    <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn"><span class="social-linkedin" aria-hidden="true">in</span></a>
  </nav>
</aside>
