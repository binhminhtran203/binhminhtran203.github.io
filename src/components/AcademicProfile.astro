---
import { getLocale, localizePath, text } from '../i18n';
import Portrait from './Portrait.astro';
import AcademicIcon from './AcademicIcon.astro';
import { profile } from '../data/profile';
const locale = getLocale(Astro.url.pathname);
const t = (en: string, vi: string) => text(locale, en, vi);
const isHome = localizePath(Astro.url.pathname, 'en') === '/';
---
<aside class="academic-profile" aria-label={t("Academic profile and contact details", "Hồ sơ học thuật và thông tin liên hệ")}>
  <a class="profile-home" href={localizePath('/', locale)} aria-label={t("Binh Minh Tran home", "Trang chủ Trần Bình Minh")}><Portrait caption={false} /></a>
  {isHome ? <h1 class="academic-profile-name">{t("Binh Minh Tran", "Trần Bình Minh")}</h1> : <p class="academic-profile-name">{t("Binh Minh Tran", "Trần Bình Minh")}</p>}
  <div class="academic-appointments">
    <p>
      <strong>{t("Visiting Researcher", "Nghiên cứu viên khách mời")}</strong>
      <span class="appointment-institution">{t("John Curtin School of Medical Research", "Trường Nghiên cứu Y khoa John Curtin")}</span>
      <span class="appointment-institution">{t("Australian National University", "Đại học Quốc gia Australia")}</span>
    </p>
  </div>
  <a class="profile-email" href={`mailto:${profile.email}`}>{profile.email}</a>
  <nav class="social-icons" aria-label={t("Academic profiles and CV", "Hồ sơ học thuật và CV")}>
    <a href={profile.scholar} target="_blank" rel="noopener noreferrer" aria-label="Google Scholar" title="Google Scholar"><AcademicIcon name="scholar" /></a>
    <a href={profile.cv} target="_blank" rel="noopener noreferrer" aria-label={t("Curriculum vitae (PDF)", "CV tiếng Anh (PDF)")} title={t("Curriculum vitae (PDF)", "CV tiếng Anh (PDF)")}><AcademicIcon name="cv" /></a>
    <a href={profile.orcid} target="_blank" rel="noopener noreferrer" aria-label="ORCID" title="ORCID"><AcademicIcon name="orcid" /></a>
    <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn"><AcademicIcon name="linkedin" /></a>
  </nav>
</aside>
