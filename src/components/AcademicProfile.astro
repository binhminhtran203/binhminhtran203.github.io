---
import { getLocale, localizePath, text } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = (en: string, vi: string) => text(locale, en, vi);
import Portrait from './Portrait.astro';
import Icon from './Icon.astro';
import { profile } from '../data/profile';
const isHome = localizePath(Astro.url.pathname, 'en') === '/';
---
<aside class="academic-profile" aria-label={t("Academic profile and contact details", "Hồ sơ học thuật và thông tin liên hệ")}>
  <div class="academic-profile-photo"><Portrait caption={false} /></div>
  <div class="academic-profile-heading">
    <p class="profile-overline">{t("Academic profile", "Hồ sơ học thuật")}</p>
    {isHome ? <h1 class="academic-profile-name">{t("Binh Minh Tran", "Trần Bình Minh")}</h1> : <h2 class="academic-profile-name">{t("Binh Minh Tran", "Trần Bình Minh")}</h2>}
    <p class="academic-profile-field">{t("Biomedical AI · Computational biology", "Trí tuệ nhân tạo y sinh · Sinh học tính toán")}</p>
  </div>
  <div class="academic-appointments">
    <p>
      <strong>{t("Visiting Researcher", "Nghiên cứu viên khách mời")}</strong>
      <span class="appointment-institution">{t("Australian National University", "Đại học Quốc gia Australia")}</span>
      <span class="appointment-note">{t("Centre for Computational Biomedical Sciences", "Trung tâm Khoa học Y sinh Tính toán")}</span>
      <span class="appointment-note">{t("John Curtin School of Medical Research", "Trường Nghiên cứu Y khoa John Curtin")}</span>
    </p>
    <p>
      <strong>{t("Honour Research Student", "Sinh viên nghiên cứu chương trình cử nhân danh dự")}</strong>
      <span class="appointment-institution">{t("The University of Sydney", "Đại học Sydney")}</span>
      <span class="appointment-note">{t("Bachelor of Advanced Computing", "Cử nhân Khoa học Máy tính nâng cao (danh dự)")}</span>
    </p>
  </div>
  <div class="academic-profile-links">
    <div class="profile-contact-line">
      <a class="profile-email" href={`mailto:${profile.email}`}><Icon name="mail" size={15} /><span>{profile.email}</span></a>
    </div>
    <nav class="profile-resource-links" aria-label={t("Academic profiles and CV", "Hồ sơ học thuật và CV")}>
      <a href={profile.cv} target="_blank" rel="noopener noreferrer">{t("Curriculum vitae", "CV tiếng Anh")} <span class="profile-file-type">PDF</span></a>
      <a href={profile.scholar} target="_blank" rel="noopener noreferrer">Google Scholar</a>
      <a href={profile.orcid} target="_blank" rel="noopener noreferrer">ORCID</a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
  </div>
</aside>
