---
import { getLocale, localizePath, text } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = (en: string, vi: string) => text(locale, en, vi);
interface Paper { id: string; title: string; authors: string[]; equalContribution: string[]; year: number; status: string; venue: string; citation: string; topics: string[]; links: {label: string;url: string;download?: boolean}[]; bibtex: string; }
interface Props { paper: Paper; compact?: boolean; }
const { paper, compact = false } = Astro.props;
---
<article class:list={['publication', { 'publication-compact': compact }]} data-status={paper.status} data-search={`${paper.title} ${paper.authors.join(' ')} ${paper.venue} ${paper.topics.join(' ')}`.toLowerCase()}>
  <div class="pub-index"><span>[{paper.id}]</span></div>
  <div class="pub-body">
    <h3 lang="en">{paper.links[0] ? <a href={paper.links[0].url} target="_blank" rel="noopener noreferrer">{paper.title}</a> : paper.title}</h3>
    <p class="authors">{paper.authors.map((author,i)=><>{i > 0 && ', '}{author === 'B. M. Tran' ? <strong>{author}</strong> : author}{paper.equalContribution.includes(author) && <sup>†</sup>}</>)}</p>
    <p class="citation" lang="en">{paper.citation}</p>
    {paper.status === 'review' && <div class="pub-meta"><span class="badge badge-review">{t("Under review", "Đang phản biện")}</span></div>}
    <div class="pub-actions">{paper.links.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer" download={link.download || undefined} aria-label={link.download ? `${t("Download full paper (PDF)", "Tải toàn văn (PDF)")}: ${paper.title}` : undefined}>[{link.label === "Proceedings" ? t("Proceedings", "Kỷ yếu") : link.label === "Full paper (PDF)" ? t("Full paper (PDF)", "Toàn văn (PDF)") : link.label}]</a>)}{!compact && <button class="copy-bibtex" type="button" data-bibtex={paper.bibtex} aria-label={`${t("Copy BibTeX for", "Sao chép BibTeX cho")} ${paper.title}`}>[<span>{t("Copy BibTeX", "Sao chép BibTeX")}</span>]</button>}</div>
    {!compact && <details class="bibtex-details"><summary>[{t("BibTeX source", "Mã BibTeX")}]</summary><pre><code>{paper.bibtex}</code></pre></details>}
  </div>
</article>
