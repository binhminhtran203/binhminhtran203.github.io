---
import { getLocale, localizePath, text } from '../i18n';
import translationData from '../data/publications.vi.json';

// One paper in the usual academic-homepage list (as in al-folio,
// academicpages and Jon Barron's page): the title in bold, then the authors
// (my name in bold, † for equal contribution), the venue and year in italics
// with the venue's rank in brackets where it has one ("(CORE B)") and the
// status, and a row of bracketed links. BibTeX copies to the
// clipboard; if that is not allowed, the source opens under the entry.
interface Link { label: string; url: string; download?: boolean; }
interface Paper { id: string; title: string; authors: string[]; equalContribution: string[]; year: number; status: string; venue: string; rank?: string; citation: string; note?: string; summary?: string; project?: string; topics: string[]; links: Link[]; bibtex: string; }
interface Translation { title: string; citation: string; note?: string; summary?: string; }
interface Props { paper: Paper; currentProject?: string; }
const { paper, currentProject } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = (en: string, vi: string) => text(locale, en, vi);
const translation = locale === 'vi' ? (translationData as Record<string, Translation>)[paper.id] : undefined;
const lang = translation ? 'vi' : 'en';
const displayTitle = translation?.title || paper.title;
const citation = translation?.citation || paper.citation;
const note = translation ? translation.note : paper.note;
const summary = translation?.summary || paper.summary;

const projectHref = paper.project && paper.project !== currentProject ? localizePath(`/research/${paper.project}/`, locale) : undefined;
const linkLabels: Record<string, string> = {
  'Proceedings': t('Proceedings', 'Kỷ yếu'),
  'Full paper (PDF)': 'PDF',
  'Preprint (PDF)': t('Preprint', 'Bản thảo'),
};
const downloadLabels: Record<string, string> = {
  'Preprint (PDF)': t('Download preprint (PDF)', 'Tải bản thảo (PDF)'),
};
const links = [
  ...(projectHref ? [{ label: t('Project page', 'Trang dự án'), url: projectHref, external: false, download: false, aria: undefined }] : []),
  ...paper.links.map(link => ({ label: linkLabels[link.label] ?? link.label, url: link.url, external: true, download: Boolean(link.download), aria: link.download ? `${downloadLabels[link.label] ?? t('Download full paper (PDF)', 'Tải toàn văn (PDF)')}: ${displayTitle}` : undefined })),
];
---
<article id={`paper-${paper.id}`} class="publication" data-status={paper.status} data-search={`${displayTitle} ${paper.title} ${paper.authors.join(' ')} ${paper.venue} ${paper.rank ?? ''} ${paper.topics.join(' ')} ${summary ?? ''}`.toLowerCase()}>
  <h3 class="pub-title" lang={lang}>{displayTitle}</h3>
  {translation && <p class="publication-original-title" lang="en">{paper.title}</p>}
  <p class="authors">{paper.authors.map((author, i) => <>{i > 0 && ', '}{author === 'B. M. Tran' ? <strong>{author}</strong> : author}{paper.equalContribution.includes(author) && <sup>†</sup>}</>)}</p>
  <p class="pub-venue"><em class="citation" lang={lang}>{citation}</em>{paper.rank && <>{' '}<span class="pub-rank">({paper.rank})</span></>}{note && <>{' '}<span class="pub-note" lang={lang}>{note}</span></>}</p>
  <p class="pub-links">
    {links.map(link => <a href={link.url} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined} download={link.download || undefined} aria-label={link.aria}><span aria-hidden="true">[</span>{link.label}<span aria-hidden="true">]</span></a>)}
    <button class="copy-bibtex" type="button" data-bibtex={paper.bibtex} aria-label={`${t('Copy BibTeX for', 'Sao chép BibTeX cho')} ${displayTitle}`}><span aria-hidden="true">[</span><span class="copy-bibtex-label">BibTeX</span><span aria-hidden="true">]</span></button>
  </p>
  <details class="bibtex-details" hidden><summary>{t('BibTeX source', 'Mã BibTeX')}</summary><pre><code>{paper.bibtex}</code></pre></details>
</article>
<script>
  // Copy BibTeX to the clipboard; if that is not allowed, open the source below the entry.
  const vietnamese = document.documentElement.lang === 'vi';
  const liveStatus = () => {
    let status = document.querySelector<HTMLElement>('#clipboard-status');
    if (!status) {
      status = document.createElement('p');
      status.id = 'clipboard-status';
      status.className = 'sr-only';
      status.setAttribute('aria-live', 'polite');
      document.body.append(status);
    }
    return status;
  };
  document.querySelectorAll<HTMLButtonElement>('.copy-bibtex').forEach(button => button.addEventListener('click', async () => {
    const label = button.querySelector('.copy-bibtex-label');
    try {
      await navigator.clipboard.writeText(button.dataset.bibtex || '');
      if (label) label.textContent = vietnamese ? 'Đã sao chép' : 'Copied';
      liveStatus().textContent = vietnamese ? 'Đã sao chép trích dẫn BibTeX vào bảng nhớ tạm.' : 'BibTeX citation copied to clipboard.';
      setTimeout(() => { if (label) label.textContent = 'BibTeX'; }, 2200);
    } catch {
      const details = button.closest('.publication')?.querySelector<HTMLDetailsElement>('.bibtex-details');
      if (details) { details.hidden = false; details.open = true; }
      liveStatus().textContent = vietnamese ? 'Không thể truy cập bảng nhớ tạm. Trích dẫn đã được mở bên dưới để bạn sao chép thủ công.' : 'Clipboard unavailable. The citation is open below for manual copying.';
    }
  }));
</script>
