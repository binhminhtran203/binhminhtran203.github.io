---
interface Paper { id: string; title: string; authors: string[]; equalContribution: string[]; year: number; status: string; venue: string; citation: string; topics: string[]; links: {label: string;url: string;download?: boolean}[]; bibtex: string; }
interface Props { paper: Paper; compact?: boolean; }
const { paper, compact = false } = Astro.props;
---
<article class:list={['publication', { 'publication-compact': compact }]} data-status={paper.status} data-search={`${paper.title} ${paper.authors.join(' ')} ${paper.venue} ${paper.topics.join(' ')}`.toLowerCase()}>
  <div class="pub-index"><span>[{paper.id}]</span></div>
  <div class="pub-body">
    <h3>{paper.links[0] ? <a href={paper.links[0].url} target="_blank" rel="noopener noreferrer">{paper.title}</a> : paper.title}</h3>
    <p class="authors">{paper.authors.map((author,i)=><>{i > 0 && ', '}{author === 'B. M. Tran' ? <strong>{author}</strong> : author}{paper.equalContribution.includes(author) && <sup>†</sup>}</>)}</p>
    <p class="citation">{paper.citation}</p>
    {paper.status === 'review' && <div class="pub-meta"><span class="badge badge-review">Under review</span></div>}
    <div class="pub-actions">{paper.links.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer" download={link.download || undefined} aria-label={link.download ? `Download full paper (PDF): ${paper.title}` : undefined}>[{link.label}]</a>)}{!compact && <button class="copy-bibtex" type="button" data-bibtex={paper.bibtex} aria-label={`Copy BibTeX for ${paper.title}`}>[<span>Copy BibTeX</span>]</button>}</div>
    {!compact && <details class="bibtex-details"><summary>[BibTeX source]</summary><pre><code>{paper.bibtex}</code></pre></details>}
  </div>
</article>
