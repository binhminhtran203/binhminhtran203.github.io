---
import { getLocale, localizePath, text } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = (en: string, vi: string) => text(locale, en, vi);
import type { projects } from '../data/profile';
interface Props { project: typeof projects[number]; }
const { project } = Astro.props;
---
<article class="project-card" id={project.slug}>
  <div class="project-record-meta"><p>{project.period}</p><p>{project.status}</p></div>
  <div class="project-text"><p class="eyebrow">{project.category}</p><h3><a href={localizePath(`/research/${project.slug}/`, locale)}>{project.short}</a></h3><p>{project.description}</p><p class="project-role">{project.role}</p><a class="text-link" href={localizePath(`/research/${project.slug}/`, locale)}>{t("Project details", "Chi tiết dự án")}</a></div>
</article>
