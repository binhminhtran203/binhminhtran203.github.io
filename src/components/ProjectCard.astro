---
import type { projects } from '../data/profile';
interface Props { project: typeof projects[number]; }
const { project } = Astro.props;
---
<article class="project-card" id={project.slug}>
  <div class="project-record-meta"><p>{project.period}</p><p>{project.status}</p></div>
  <div class="project-text"><p class="eyebrow">{project.category}</p><h3><a href={`/research/${project.slug}/`}>{project.short}</a></h3><p>{project.description}</p><p class="project-role">{project.role}</p><a class="text-link" href={`/research/${project.slug}/`}>Project details</a></div>
</article>
