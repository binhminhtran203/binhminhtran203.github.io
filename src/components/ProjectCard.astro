---
import { getLocale, localizePath, text } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = (en: string, vi: string) => text(locale, en, vi);
import type { projects } from '../data/profile';
import ResearchArt from './ResearchArt.astro';
import Icon from './Icon.astro';
interface Props { project: typeof projects[number]; }
const { project } = Astro.props;
const projectPath = localizePath(`/research/${project.slug}/`, locale);
---
<article class="project-card" id={project.slug}>
  <figure class:list={['project-card-visual', `visual-${project.visual}`]}>
    <ResearchArt kind={project.visual} />
    <figcaption>{t("Conceptual illustration", "Sơ đồ minh họa")}</figcaption>
  </figure>
  <div class="project-text">
    <div class="project-record-meta">
      <p class="project-record-number">{t("Project", "Dự án")} {project.number}</p>
      <p>{project.period}</p>
      <p class="project-record-status">{project.status}</p>
    </div>
    <p class="eyebrow">{project.category}</p>
    <h3><a href={projectPath}>{project.short}</a></h3>
    <p>{project.description}</p>
    <p class="project-role">{project.role}</p>
    <a class="text-link" href={projectPath}>{t("Project details", "Chi tiết dự án")} <Icon size={15} /></a>
  </div>
</article>
