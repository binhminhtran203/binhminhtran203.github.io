---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import AcademicProfile from '../components/AcademicProfile.astro';
import { profile as profileEn } from '../data/profile';
import { profileVi } from '../data/profile.vi';
import { researchStory as researchStoryEn, leadership as leadershipEn, media as mediaEn } from '../data/community';
import { researchStoryVi, leadershipVi, mediaVi } from '../data/community.vi';
import { getLocale, text } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = (en: string, vi: string) => text(locale, en, vi);
const profile = locale === 'vi' ? profileVi : profileEn;
const researchStory = locale === 'vi' ? researchStoryVi : researchStoryEn;
const leadership = locale === 'vi' ? leadershipVi : leadershipEn;
const media = locale === 'vi' ? mediaVi : mediaEn;
const experience = [
  {date:t("Oct 2026 — present", "Tháng 10/2026 — nay"),role:t("Visiting Researcher", "Nghiên cứu viên khách mời"),institution:t("Australian National University", "Đại học Quốc gia Australia"),detail:t("Centre for Computational Biomedical Sciences, John Curtin School of Medical Research. Preliminary work on computational RNA biology and AI/ML interpretation of genetic variants affecting RNA modifications.", "Thực hiện các nghiên cứu bước đầu về sinh học RNA tính toán tại Trung tâm Khoa học Y sinh Tính toán, Trường Nghiên cứu Y khoa John Curtin. Ứng dụng trí tuệ nhân tạo và học máy để tìm hiểu ảnh hưởng của các biến thể di truyền đến những biến đổi hóa học của RNA."),supervisor:t("Research host: Professor Eduardo Eyras", "Người phụ trách nghiên cứu tại đơn vị tiếp nhận: Giáo sư Eduardo Eyras")},
  {date:t("Feb — Oct 2026", "Tháng 2 — tháng 10/2026"),role:t("Honours Research Student", "Sinh viên nghiên cứu chương trình cử nhân danh dự"),institution:t("The University of Sydney", "Đại học Sydney"),detail:t("Designed NIMSurv, a hierarchical graph model combining clinical data and imaging mass cytometry for breast cancer survival prediction.", "Thiết kế NIMSurv, mô hình học trên đồ thị phân cấp kết hợp dữ liệu lâm sàng với dữ liệu hình ảnh mô từ kỹ thuật đo tế bào khối phổ (IMC), nhằm dự đoán kết cục sống còn ở bệnh nhân ung thư vú."),supervisor:t("Supervisor: Associate Professor Xiuying Wang", "Người hướng dẫn: Phó Giáo sư Xiuying Wang")},
  {date:t("Dec 2025 — present", "Tháng 12/2025 — nay"),role:t("Research Collaborator", "Cộng tác viên nghiên cứu"),institution:t("Hanoi Medical University", "Trường Đại học Y Hà Nội"),detail:t("Multimodal and multitask learning for breast cancer receptor status prediction, integrating clinical variables, H&E whole-slide images, and RNA-seq.", "Nghiên cứu các phương pháp học đa phương thức và học đa nhiệm để dự đoán tình trạng biểu hiện thụ thể ở bệnh nhân ung thư vú. Kết hợp dữ liệu lâm sàng, ảnh toàn tiêu bản mô bệnh học nhuộm hematoxylin–eosin (H&E) và dữ liệu giải trình tự RNA (RNA-seq).")},
  {date:t("Dec 2025 — Mar 2026", "Tháng 12/2025 — tháng 3/2026"),role:t("Research Assistant", "Trợ lý nghiên cứu"),institution:t("Vietnam Academy of Science and Technology", "Viện Hàn lâm Khoa học và Công nghệ Việt Nam"),detail:t("Reproducible NGS preprocessing and annotation workflows for mutation and microbial gene-function analyses.", "Xây dựng quy trình tiền xử lý và chú giải dữ liệu giải trình tự thế hệ mới (NGS), bảo đảm khả năng tái lập kết quả, phục vụ phân tích đột biến và chức năng gen ở vi sinh vật.")},
  {date:t("Dec 2024 — Dec 2025", "Tháng 12/2024 — tháng 12/2025"),role:t("Research Collaborator", "Cộng tác viên nghiên cứu"),institution:t("Hanoi University of Industry", "Trường Đại học Công nghiệp Hà Nội"),detail:t("Variational multi-view and dual-stream contrastive graph models for lncRNA–disease association prediction.", "Nghiên cứu các mô hình học trên đồ thị dựa trên học biến phân đa góc nhìn và học tương phản hai luồng, nhằm dự đoán mối liên hệ giữa RNA dài không mã hóa (lncRNA) và bệnh."),supervisor:t("Supervisor: Associate Professor Dang Hung Tran", "Người hướng dẫn: Phó Giáo sư Dang Hung Tran")},
];
const awards = [
  {year:'2026',title:t("AURORA Scientific Research Awards", "Giải thưởng Nghiên cứu Khoa học AURORA"),detail:t("Top 10 finalist · Vietnam–Australia Innovation Network (NIC-AU). Grand Final scheduled for December 2026.", "Được lựa chọn vào nhóm 10 xuất sắc nhất của Giải thưởng AURORA, Mạng lưới Đổi mới sáng tạo Việt Nam–Australia (NIC-AU). Vòng chung kết dự kiến diễn ra vào tháng 12/2026.")},
  {year:'2026',title:t("Outstanding Student Award", "Danh hiệu Sinh viên xuất sắc"),detail:t("Embassy of Vietnam in Australia · Academic and research achievement.", "Được Đại sứ quán Việt Nam tại Australia trao tặng nhằm ghi nhận thành tích trong học tập và nghiên cứu khoa học.")},
  {year:'2026',title:t("Vietnamese Young Intellectuals Forum in Australia", "Diễn đàn Trí thức trẻ Việt Nam tại Australia"),detail:t("Second Prize · Breast cancer receptor-status research.", "Đạt giải Nhì với nghiên cứu về tình trạng biểu hiện thụ thể trong ung thư vú.")},
  {year:'2026',title:t("Youth Science and Technology Conference", "Hội nghị Khoa học và Công nghệ tuổi trẻ"),detail:t("Third Prize · Hanoi Medical University; selected for the 23rd Youth Science and Technology Conference of the Vietnamese Health Sector.", "Đạt giải Ba tại Trường Đại học Y Hà Nội và được lựa chọn tham dự Hội nghị Khoa học và Công nghệ tuổi trẻ ngành Y tế lần thứ 23.")},
  {year:'2025',title:t("January Star Award", "Giải thưởng Sao Tháng Giêng"),detail:t("Vietnam National Union of Students · Academic achievement, research, and student leadership.", "Do Trung ương Hội Sinh viên Việt Nam trao tặng, ghi nhận thành tích học tập, nghiên cứu khoa học và đóng góp trong công tác Hội.")},
];
---
<Layout title={t("About & CV", "Giới thiệu và CV")} description={t("Academic background, research experience, selected awards, and curriculum vitae of Binh Minh Tran.", "Quá trình học tập, kinh nghiệm nghiên cứu, giải thưởng tiêu biểu và hồ sơ học thuật của Trần Bình Minh.")}>
  <div class="container academic-shell about-shell">
    <AcademicProfile />
    <section class="academic-main biography-section" aria-labelledby="about-title">
      <p class="academic-kicker">{t("Biography & research motivation", "Câu chuyện và động lực nghiên cứu")}</p>
      <h1 id="about-title">{t("About", "Giới thiệu")}</h1>
      <nav class="about-sections-nav" aria-label={t("On this page", "Nội dung trang")}><a href="#education">{t("Education", "Học vấn")}</a><a href="#experience">{t("Experience", "Kinh nghiệm")}</a><a href="#community">{t("Community", "Cộng đồng")}</a><a href="#media">{t("Media", "Truyền thông")}</a><a href="#awards">{t("Awards", "Giải thưởng")}</a></nav>
      <div class="biography-text">{researchStory.map(paragraph=><p class="about-bio">{paragraph}</p>)}</div>
      <a class="text-link biography-cv" href={profile.cv} download>{t("Download curriculum vitae", "Tải lý lịch học thuật (CV, tiếng Anh)")} <Icon name="download" size={16} /></a>
    </section>
  </div>
  <section class="container about-section" id="education"><div class="about-section-label"><h2>{t("Education", "Học vấn")}</h2></div><div class="timeline">
    <article class="timeline-entry upcoming-entry"><span class="badge badge-review">{t("Prospective · 2027 — 2031", "Dự kiến · 2027 — 2031")}</span><h3>{t("PhD Student", "Nghiên cứu sinh tiến sĩ")}</h3><p class="institution">{t("Australian National University", "Đại học Quốc gia Australia")}</p><p>{t("Medical Science", "Ngành Khoa học y học")}</p><p>{t("Planned doctoral research in computational RNA biology with Professor Eduardo Eyras.", "Dự kiến thực hiện nghiên cứu tiến sĩ về sinh học RNA tính toán dưới sự hướng dẫn của Giáo sư Eduardo Eyras.")}</p></article>
    <article class="timeline-entry"><span class="timeline-date">{t("2023 — present", "2023 — nay")}</span><h3>{t("Bachelor of Advanced Computing (Honours)", "Cử nhân Khoa học Máy tính nâng cao (danh dự)")}</h3><p class="institution">{t("The University of Sydney", "Đại học Sydney")}</p><p>{t("Computational Data Science · Expected completion: December 2026", "Chuyên ngành Khoa học dữ liệu tính toán · Dự kiến hoàn thành tháng 12/2026")}</p><p class="small-note">{t("Honours thesis: Multimodal Breast Cancer Survival Prediction with Hierarchical Niche–Interface Graph Learning. Supervisor: Associate Professor Xiuying Wang.", "Luận văn tốt nghiệp: Dự đoán sống còn ở bệnh nhân ung thư vú bằng học đa phương thức trên đồ thị phân cấp của các vi vùng mô và vùng tiếp giáp. Người hướng dẫn: Phó Giáo sư Xiuying Wang.")}</p></article>
    <article class="timeline-entry"><span class="timeline-date">2019 — 2022</span><h3>{t("Specialised Physics Programme", "Chuyên Vật lý")}</h3><p class="institution">{t("HUS High School for Gifted Students", "Trường Trung học phổ thông Chuyên Khoa học Tự nhiên")}</p><p>{t("VNU University of Science, Vietnam National University, Hanoi.", "Trường Đại học Khoa học Tự nhiên, Đại học Quốc gia Hà Nội.")}</p></article>
  </div></section>
  <section class="container about-section" id="experience"><div class="about-section-label"><h2>{t("Experience", "Kinh nghiệm")}</h2></div><div class="timeline">{experience.map(item=><article class="timeline-entry"><span class="timeline-date">{item.date}</span><h3>{item.role}</h3><p class="institution">{item.institution}</p><p>{item.detail}</p>{item.supervisor && <p class="small-note">{item.supervisor}</p>}</article>)}<article class="timeline-entry"><span class="timeline-date">{t("Dec 2024 — Mar 2025", "Tháng 12/2024 — tháng 3/2025")}</span><h3>{t("Data Engineer Intern", "Thực tập sinh kỹ thuật dữ liệu")}</h3><p class="institution">Viettel Software</p><p>{t("Built and maintained Python/SQL ETL pipelines for operational datasets. Implemented data-quality checks, contributed to schema design and technical documentation, and optimised queries and pipeline performance for downstream analytics.", "Xây dựng và duy trì quy trình trích xuất, chuyển đổi và nạp dữ liệu bằng Python và SQL để xử lý dữ liệu vận hành. Kiểm tra chất lượng dữ liệu, tham gia thiết kế lược đồ cơ sở dữ liệu và biên soạn tài liệu kỹ thuật; tối ưu hóa truy vấn và hiệu năng xử lý để phục vụ phân tích dữ liệu.")}</p></article><article class="timeline-entry"><span class="timeline-date">{t("Jun — Jul 2024", "Tháng 6 — tháng 7/2024")}</span><h3>{t("Data Engineer Intern", "Thực tập sinh kỹ thuật dữ liệu")}</h3><p class="institution">Agribank</p><p>{t("Supported ETL of banking datasets into internal reporting systems, prepared structured operational datasets, and contributed to dashboards and reports for internal stakeholders.", "Hỗ trợ trích xuất, chuyển đổi và nạp dữ liệu ngân hàng vào hệ thống báo cáo nội bộ. Chuẩn bị dữ liệu vận hành có cấu trúc và tham gia xây dựng các bảng theo dõi, trực quan hóa dữ liệu cùng báo cáo phục vụ các đơn vị trong ngân hàng.")}</p></article></div></section>
  <section class="community-section" id="community"><div class="container"><div class="section-heading"><div><h2>{t("Leadership & service", "Công tác Hội và đóng góp cộng đồng")}</h2></div><p class="section-intro">{t("Alongside research, I contribute to the Vietnamese student community in Australia through student leadership and organisational service. I value the connections between academic life, professional development, and community.", "Bên cạnh nghiên cứu, tôi tham gia công tác Hội và các hoạt động của cộng đồng sinh viên Việt Nam tại Australia. Tôi coi trọng việc gắn kết học tập, nghiên cứu và phát triển nghề nghiệp với đời sống cộng đồng.")}</p></div><div class="leadership-grid">{leadership.map((item,index)=><article class="leadership-card"><div class="leadership-card-top"><span class="eyebrow">{t("Student leadership", "Công tác Hội sinh viên")}</span><span class:list={['badge',{'badge-review':leadershipEn[index].status==='Previous'}]}>{item.status}</span></div><h3>{item.role}</h3><p class="leadership-organisation">{item.organisation}</p><p class="small-note">{item.period}</p></article>)}</div><div class="community-source"><a class="text-link" href={profile.linkedin} target="_blank" rel="noopener noreferrer">{t("More on LinkedIn", "Xem thêm trên LinkedIn")} <Icon name="external" size={15} /></a></div></div></section>
  <section class="container media-section" id="media"><div class="section-heading section-heading-inline"><div><h2>{t("Media & engagement", "Truyền thông và hoạt động cộng đồng")}</h2></div><span class="small-note">{t("Research, student life & community", "Nghiên cứu, đời sống sinh viên và cộng đồng")}</span></div><div class="media-grid">{media.map(item=><article class="media-card"><div class="media-card-meta"><span class="media-outlet">{item.outlet}</span><span>{item.kind}</span></div><h3>{item.title}</h3><p>{item.description}</p><a class="text-link" href={item.url} target="_blank" rel="noopener noreferrer">{item.linkLabel} <Icon name="external" size={16} /></a></article>)}</div></section>
  <section class="skills-section"><div class="container"><h2>{t("Research methods & tools", "Phương pháp và công cụ nghiên cứu")}</h2><div class="skills-grid"><div><h3>{t("Build", "Lập trình và công cụ")}</h3><p>Python · R · SQL · Bash<br />PyTorch · PyTorch Geometric · scikit-learn<br />Git · Linux · LaTeX</p></div><div><h3>{t("Model", "Mô hình hóa")}</h3><p>{t("Graph neural networks · Multimodal fusion", "Mạng nơ-ron đồ thị · Tích hợp đa phương thức")}<br />{t("Multiple-instance & contrastive learning", "Học đa thể hiện và học tương phản")}<br />{t("Cox & discrete-time survival models", "Mô hình Cox và mô hình sống còn thời gian rời rạc")}</p></div><div><h3>{t("Evaluate", "Đánh giá")}</h3><p>{t("Patient-level nested cross-validation", "Đánh giá chéo lồng nhau ở cấp bệnh nhân")}<br />{t("Bootstrap confidence intervals · Calibration", "Khoảng tin cậy từ tái lấy mẫu có hoàn lại · Độ hiệu chuẩn")}<br />{t("External validation · Experiment tracking", "Thẩm định trên dữ liệu độc lập · Theo dõi thực nghiệm")}</p></div></div></div></section>
  <section class="container about-section awards-section" id="awards"><div class="about-section-label"><h2>{t("Selected awards", "Giải thưởng và danh hiệu tiêu biểu")}</h2></div><div>{awards.map(award=><article class="award-entry"><span>{award.year}</span><div><h3>{award.title}</h3><p>{award.detail}</p></div></article>)}<p class="small-note awards-footnote">{t("Sydney International Student Award recipient since 2023. Full scholarship and award details are available in my CV.", "Được nhận học bổng hỗ trợ học phí dành cho sinh viên quốc tế của Đại học Sydney từ năm 2023. Thông tin chi tiết về các học bổng và giải thưởng được trình bày trong bản lý lịch học thuật.")}</p></div></section>
</Layout>
