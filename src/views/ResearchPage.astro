---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects as projectsEn } from '../data/profile';
import { projectsVi } from '../data/profile.vi';
import { getLocale, text } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = (en: string, vi: string) => text(locale, en, vi);
const projects = locale === 'vi' ? projectsVi : projectsEn;
---
<Layout title={t("Research", "Nghiên cứu")} description={t("Research by Trần Bình Minh in graph learning, multimodal biomedical AI, computational RNA biology, and individualised probability modelling after high-risk NIPT.", "Nghiên cứu của Trần Bình Minh về học trên đồ thị, trí tuệ nhân tạo đa phương thức trong y sinh, sinh học RNA tính toán và mô hình xác suất cá thể hóa sau kết quả NIPT nguy cơ cao.")}>
  <section class="page-header container"><p class="academic-kicker">{t("Research overview", "Tổng quan nghiên cứu")}</p><h1>{t("Research", "Nghiên cứu")}</h1><p class="page-lead">{t("I build machine learning methods that connect different views of biological systems, from RNA networks and tissue microenvironments to patient outcomes.", "Tôi phát triển các phương pháp học máy để kết nối thông tin ở nhiều cấp độ của hệ sinh học, từ mạng lưới RNA và vi môi trường mô đến kết cục lâm sàng.")}</p></section>
  <section class="container research-overview" id="current"><div class="research-direction"><p class="eyebrow"><span class="status-dot"></span> {t("Current focus · ANU", "Hướng nghiên cứu hiện tại · ANU")}</p><h2>{t("Computational RNA biology", "Sinh học RNA tính toán")}</h2><p>{t("I’m undertaking preliminary research with Professor Eduardo Eyras at the Centre for Computational Biomedical Sciences, John Curtin School of Medical Research, Australian National University.", "Hiện tôi đang thực hiện những nghiên cứu ban đầu cùng Giáo sư Eduardo Eyras tại Trung tâm Khoa học Y sinh Tính toán, Trường Nghiên cứu Y khoa John Curtin, Đại học Quốc gia Australia.")}</p><p>{t("The central question: how can AI/ML help interpret variants that affect RNA modifications such as m6A, pseudouridine, and m5C, while distinguishing predicted modification changes from disease-relevant functional effects?", "Câu hỏi tôi theo đuổi là: trí tuệ nhân tạo và học máy có thể giúp diễn giải các biến thể ảnh hưởng đến biến đổi hóa học trên RNA, như m6A, pseudouridine và m5C, như thế nào? Trong đó, điều quan trọng là phân biệt những thay đổi được mô hình dự đoán với tác động chức năng liên quan đến bệnh.")}</p><div class="tag-row"><span>{t("Computational RNA biology", "Sinh học RNA tính toán")}</span><span>{t("Variant interpretation", "Diễn giải biến thể")}</span><span>{t("RNA modifications", "Biến đổi hóa học của RNA")}</span></div><p class="small-note">{t("Visiting Researcher since October 2026 · Early-stage research", "Nghiên cứu viên khách mời từ tháng 10/2026 · Nghiên cứu đang ở giai đoạn đầu")}</p></div><aside class="research-principles"><p class="eyebrow">{t("How I approach research", "Cách tôi tiếp cận nghiên cứu")}</p><ol><li><span>01</span><div><h3>{t("Represent the structure", "Biểu diễn cấu trúc")}</h3><p>{t("Use graphs to model relationships across cells, molecules, and biological networks.", "Sử dụng đồ thị để mô hình hóa mối quan hệ giữa tế bào, phân tử và các mạng lưới sinh học.")}</p></div></li><li><span>02</span><div><h3>{t("Connect the modalities", "Tích hợp các nguồn dữ liệu")}</h3><p>{t("Bring molecular, imaging, and clinical information into a shared learning framework.", "Tích hợp dữ liệu phân tử, hình ảnh và lâm sàng trong cùng một mô hình học máy.")}</p></div></li><li><span>03</span><div><h3>{t("Evaluate carefully", "Đánh giá cẩn trọng")}</h3><p>{t("Use patient-level validation, external cohorts, and interpretable analyses.", "Thẩm định mô hình ở cấp bệnh nhân và trên các đoàn hệ độc lập, kết hợp phân tích khả năng diễn giải.")}</p></div></li></ol></aside></section>
  <section class="section container"><div class="section-heading section-heading-inline"><div><h2>{t("Research projects", "Dự án nghiên cứu")}</h2></div><span class="small-note">{t("2024 — 2027 · Including planned work", "2024 — 2027 · Bao gồm các nghiên cứu dự kiến")}</span></div><div class="project-grid">{projects.map(project=><ProjectCard project={project} />)}</div></section>
</Layout>
