---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import AcademicProfile from '../components/AcademicProfile.astro';
import Publication from '../components/Publication.astro';
import { projects as projectsEn } from '../data/profile';
import { projectsVi } from '../data/profile.vi';
import publications from '../data/publications.json';
import { getLocale, localizePath, text } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = (en: string, vi: string) => text(locale, en, vi);
const path = (value: string) => localizePath(value, locale);
const projects = locale === 'vi' ? projectsVi : projectsEn;
const interests = [t('Multimodal learning', 'Học đa phương thức'), t('Graph neural networks', 'Mạng nơ-ron đồ thị'), t('Survival analysis', 'Phân tích sống còn'), t('Cancer research', 'Nghiên cứu ung thư'), t('Computational genomics', 'Hệ gen học tính toán'), t('RNA biology', 'Sinh học RNA')];
---
<Layout>
  <div class="container academic-shell">
    <AcademicProfile />
    <div class="academic-main">
      <section class="academic-introduction" aria-labelledby="biography-title">
        <h2 id="biography-title">{t('Research overview', 'Tổng quan nghiên cứu')}</h2>
        <p>{t('My research focuses on graph and multimodal learning for biomedical applications, connecting molecular signals, tissue organisation, and patient outcomes. I aim to develop trustworthy, interpretable AI methods that connect biological discovery with precision medicine.', 'Tôi nghiên cứu các phương pháp học trên đồ thị và học đa phương thức trong y sinh, nhằm tìm hiểu mối liên hệ giữa tín hiệu phân tử, cấu trúc mô và kết cục lâm sàng. Tôi mong muốn phát triển những phương pháp AI đáng tin cậy, có thể diễn giải, để đưa các khám phá sinh học đến gần hơn với y học chính xác.')}</p>
        <p>{t('At the Australian National University, I am undertaking preliminary research in computational RNA biology with Professor Eduardo Eyras at the Centre for Computational Biomedical Sciences, John Curtin School of Medical Research.', 'Hiện tôi đang thực hiện những nghiên cứu ban đầu về sinh học RNA tính toán cùng Giáo sư Eduardo Eyras tại Trung tâm Khoa học Y sinh Tính toán, Trường Nghiên cứu Y khoa John Curtin, Đại học Quốc gia Australia.')}</p>
        <a class="text-link" href={path('/about/')}>{t('Biography and academic background', 'Giới thiệu và hành trình học thuật')}</a>
      </section>
      <section class="academic-section" aria-labelledby="interests-title">
        <h2 id="interests-title">{t('Research interests', 'Hướng nghiên cứu')}</h2>
        <ul class="research-interest-list">{interests.map(interest=><li>{interest}</li>)}</ul>
      </section>
      <section class="academic-section academic-selected-publications" aria-labelledby="selected-title">
        <div class="academic-section-heading"><h2 id="selected-title">{t('Selected publications', 'Công bố tiêu biểu')}</h2><a class="text-link" href={path('/publications/')}>{t('All publications', 'Danh sách công bố')}</a></div>
        <div class="publication-list">{publications.filter(p=>p.status==='published').map(paper=><Publication paper={paper} compact />)}</div>
        <p class="section-footnote">{t('† Equal contribution. Manuscripts under review are listed separately on the publications page.', '† Các tác giả có đóng góp ngang nhau. Bản thảo đang phản biện được trình bày riêng trong danh sách công bố.')}</p>
      </section>
      <section class="academic-section" aria-labelledby="projects-title">
        <div class="academic-section-heading"><h2 id="projects-title">{t('Research projects', 'Dự án nghiên cứu')}</h2><a class="text-link" href={path('/research/')}>{t('Project details', 'Chi tiết dự án')}</a></div>
        <div class="research-summaries">{projects.map(project=><article><div class="research-summary-heading"><h3><a href={path(`/research/${project.slug}/`)}>{project.short}</a></h3><span>{project.period}</span></div><p>{project.description}</p></article>)}</div>
      </section>
      <section class="academic-section academic-community-note" aria-labelledby="service-title"><h2 id="service-title">{t('Academic & community engagement', 'Hoạt động học thuật và cộng đồng')}</h2><p>{t('Alongside research, I contribute to the Vietnamese student community in Australia through student leadership and organisational service.', 'Bên cạnh nghiên cứu, tôi tham gia công tác Hội và các hoạt động kết nối, đóng góp cho cộng đồng sinh viên Việt Nam tại Australia.')}</p><a class="text-link" href={path('/about/#community')}>{t('Leadership & public engagement', 'Công tác Hội và hoạt động cộng đồng')} <Icon size={15} /></a></section>
    </div>
  </div>
</Layout>
