---
import Layout from '../layouts/Layout.astro';
import Publication from '../components/Publication.astro';
import publications from '../data/publications.json';
import { news } from '../data/news';
import { awards } from '../data/awards';
import { education } from '../data/education';
import { researchExperience } from '../data/experience';
import { grants } from '../data/grants';
import { presentations } from '../data/presentations';
import { getLocale, localizePath, text } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = (en: string, vi: string) => text(locale, en, vi);
const path = (value: string) => localizePath(value, locale);
// Accepted and published papers in CV order: conference papers first, then
// journal articles.
const featuredPublications = ['C', 'J'].flatMap(prefix => publications.filter(p => p.status !== 'review' && p.id.startsWith(prefix)));
// Month dates for News and Presentations: "Nov 2026" in English and "11/2026"
// in Vietnamese, like the other dated sections.
const monthsEn = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const monthYear = (iso: string) => {
  const [year, month] = iso.split('-');
  return locale === 'vi' ? `${month}/${year}` : `${monthsEn[Number(month) - 1]} ${year}`;
};
const interests = [
  { label: t('Machine learning', 'Học máy'), topics: t('multimodal learning, graph neural networks, survival analysis', 'học đa phương thức, mạng nơ-ron đồ thị, phân tích sống còn') },
  { label: t('Biomedical research', 'Nghiên cứu y sinh'), topics: t('AI in medicine, computational biology, RNA biology, cancer genomics', 'AI trong y học, sinh học tính toán, sinh học RNA, hệ gen học ung thư') },
];
---
<Layout>
  <div class="container academic-shell">
    <div class="academic-main">
      <div class="home-overview-grid">
      <section class="academic-introduction" aria-labelledby="biography-title">
        <h2 id="biography-title">{t('About Me', 'Giới thiệu')}</h2>
        {/* The bio opens, as academic homepages do, with the current position, the project (described as the host suggested and as the CV does), the planned doctorate and the first degree. The research focus and the Hanoi collaboration are the author's own sentences, and the Vietnamese text is the author's own translation. */}
        <p>{t('I am a Visiting Researcher at the Centre for Computational Biomedical Sciences, John Curtin School of Medical Research, Australian National University (ANU), where I work on computational RNA biology with Professor Eduardo Eyras. I am investigating how multimodal deep learning can incorporate epitranscriptomic evidence into genetic variant interpretation. I plan to begin my Ph.D. at ANU in 2027. Before that, I completed a Bachelor of Advanced Computing (Honours) at the University of Sydney.', 'Hiện tôi là nghiên cứu viên khách mời tại Trung tâm Khoa học Y sinh Tính toán, thuộc Trường Nghiên cứu Y khoa John Curtin, Đại học Quốc gia Australia (ANU). Tại đây, tôi nghiên cứu sinh học RNA bằng các phương pháp tính toán cùng Giáo sư Eduardo Eyras. Tôi đang nghiên cứu cách ứng dụng học sâu đa phương thức để tích hợp bằng chứng về các biến đổi hóa học trên RNA vào quá trình diễn giải ý nghĩa của các biến thể di truyền. Tôi dự kiến bắt đầu chương trình tiến sĩ tại ANU vào năm 2027. Trước đó, tôi đã hoàn thành chương trình Cử nhân Khoa học Máy tính nâng cao (Honours) tại Đại học Sydney.')}</p>
        <p>{t('My research focuses on developing artificial intelligence methods for biomedicine, particularly graph learning and multimodal learning, to explore the relationships between molecular signals, tissue structure, and clinical outcomes. I aim to build AI models that are trustworthy, interpretable, and useful in practice, helping to bridge the gap between biological discovery and applications in precision medicine.', 'Nghiên cứu của tôi tập trung vào việc phát triển các phương pháp trí tuệ nhân tạo phục vụ y sinh học, đặc biệt là học trên đồ thị và học đa phương thức, nhằm khám phá mối liên hệ giữa tín hiệu phân tử, cấu trúc mô và kết cục lâm sàng. Tôi hướng tới xây dựng các mô hình AI đáng tin cậy, có thể diễn giải và có giá trị ứng dụng thực tiễn, góp phần thu hẹp khoảng cách giữa những khám phá sinh học và ứng dụng trong y học chính xác.')}</p>
        <p>{t('I am also a research collaborator at Hanoi Medical University, where I contribute to projects applying artificial intelligence to clinical research, particularly in oncology and obstetrics and gynaecology. This work focuses on developing and evaluating machine learning models to support data analysis and predict clinical outcomes.', 'Bên cạnh đó, tôi là cộng tác viên nghiên cứu tại Trường Đại học Y Hà Nội, tham gia các dự án ứng dụng trí tuệ nhân tạo trong nghiên cứu lâm sàng, đặc biệt trong lĩnh vực ung bướu và sản phụ khoa. Công việc của tôi tập trung vào việc phát triển và đánh giá các mô hình học máy nhằm hỗ trợ phân tích dữ liệu và dự đoán kết cục lâm sàng.')}</p>
      </section>
      <section class="academic-section home-education" id="education" aria-labelledby="education-title">
        <h2 id="education-title">{t('Education', 'Học vấn')}</h2>
        <ul class="cv-list home-education-list" role="list">
          {education.map(item => <li>
            <span class="entry-date">{item.period[locale]}</span>
            <div class="entry-body">
              <span class="entry-line"><strong>{item.degree[locale]}</strong>, {item.institution[locale]}</span>
              {item.field && <span class="entry-detail">{item.field[locale]}</span>}
              {item.thesis && <span class="entry-detail">{t('Thesis', 'Luận văn')}: <a href={item.thesis.href} target="_blank" rel="noopener noreferrer" lang="en"><em>{item.thesis.title}</em></a> (PDF)</span>}
              {item.supervisor && <span class="entry-detail">{item.supervisor[locale]}</span>}
            </div>
          </li>)}
        </ul>
      </section>
      <section class="academic-section home-interests" aria-labelledby="interests-title">
        <h2 id="interests-title">{t('Research Interests', 'Hướng nghiên cứu')}</h2>
        <ul class="research-interest-list">{interests.map(interest=><li><strong>{interest.label}:</strong> {interest.topics}</li>)}</ul>
      </section>
      </div>
      <section class="academic-section home-news" id="news" aria-labelledby="news-title">
        <h2 id="news-title">{t('News', 'Tin mới')}</h2>
        <div class="news-scroll" tabindex="0" role="region" aria-label={t('Scrollable news', 'Tin mới có thể cuộn')}>
          <ul class="cv-list news-list" role="list">
            {news.map(item => <li id={`news-${item.id}`}>
              <time class="entry-date" datetime={item.date}>{monthYear(item.date)}</time>
              <div class="entry-body">{item.before[locale]}<a href={path(item.link.href)}>{item.link.label[locale]}</a>{item.after[locale]}</div>
            </li>)}
          </ul>
        </div>
      </section>
      <section class="academic-section academic-selected-publications" aria-labelledby="selected-title">
        <div class="academic-section-heading"><h2 id="selected-title">{t('Publications', 'Công bố tiêu biểu')}</h2><a class="text-link" href={path('/publications/')}>{t('All publications', 'Danh sách công bố')}</a></div>
        <div class="publication-list">{featuredPublications.map(paper=><Publication paper={paper} />)}</div>
        <p class="section-footnote">{t('† Equal contribution. Manuscripts under review are listed separately on the publications page.', '† Các tác giả có đóng góp ngang nhau. Bản thảo đang phản biện được trình bày riêng trong danh sách công bố.')}</p>
      </section>
      <section class="academic-section home-experience" id="experience" aria-labelledby="experience-title">
        <h2 id="experience-title">{t('Research Experience', 'Kinh nghiệm nghiên cứu')}</h2>
        <ul class="cv-list home-experience-list" role="list">
          {researchExperience.map(item => <li>
            <span class="entry-date">{item.period[locale]}</span>
            <div class="entry-body">
              {item.unit
                ? <><span class="entry-line"><strong>{item.role[locale]}</strong>, {item.unit[locale]},</span><span class="entry-line">{item.organisation[locale]}, {item.location[locale]}</span></>
                : <span class="entry-line"><strong>{item.role[locale]}</strong>, {item.organisation[locale]}, {item.location[locale]}</span>}
              {item.detail && <span class="entry-detail">{item.detail[locale]}</span>}
            </div>
          </li>)}
        </ul>
      </section>
      <section class="academic-section home-grants" id="grants" aria-labelledby="grants-title">
        <h2 id="grants-title">{t('Research Grants', 'Tài trợ nghiên cứu')}</h2>
        <ul class="cv-list home-grants-list" role="list">
          {grants.map(grant => <li>
            <span class="entry-date">{grant.period?.[locale]}</span>
            <div class="entry-body">
              <span class="entry-line"><strong>{grant.funder[locale]}</strong>, {grant.scheme[locale]}</span>
              {grant.project && <em class="entry-title">{grant.project[locale].split(' ').map((word, i) => <>{i > 0 && ' '}{word.includes('-') ? <span class="nowrap">{word}</span> : word}</>)}</em>}
              {(grant.role || grant.amount) && <span class="entry-detail">{[grant.role && `${t('Role', 'Vai trò')}: ${grant.role[locale]}`, grant.amount && `${t('Amount', 'Kinh phí')}: ${grant.amount[locale]}`].filter(Boolean).join(' · ')}</span>}
            </div>
          </li>)}
        </ul>
      </section>
      <section class="academic-section home-awards" id="awards" aria-labelledby="awards-title">
        <h2 id="awards-title">{t('Honours and Awards', 'Giải thưởng và danh hiệu')}</h2>
        <ul class="cv-list home-awards-list" role="list">
          {awards.map(award => <li>
            <time class="entry-date" datetime={award.year}>{award.year}</time>
            <div class="entry-body"><span class="entry-line"><strong>{award.title[locale]}</strong>, {(award.organisationShort ?? award.organisation)[locale]}</span></div>
          </li>)}
        </ul>
      </section>
      <section class="academic-section home-presentations" id="presentations" aria-labelledby="presentations-title">
        <h2 id="presentations-title">{t('Presentations', 'Báo cáo khoa học')}</h2>
        <ul class="cv-list home-presentations-list" role="list">
          {presentations.map(item => <li>
            <time class="entry-date" datetime={item.date}>{monthYear(item.date)}</time>
            <div class="entry-body">
              <span class="entry-line"><strong>{item.type[locale]}</strong>{item.language && ` (${item.language[locale]})`}, {item.event[locale]},</span>
              <span class="entry-line">{item.venue[locale]}</span>
              <em class="entry-title">{item.href ? <a href={path(item.href)}>{item.title[locale]}</a> : item.title[locale]}</em>
            </div>
          </li>)}
        </ul>
      </section>
    </div>
  </div>
</Layout>
