---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Publication from '../components/Publication.astro';
import { projects as projectsEn } from '../data/profile';
import { projectsVi } from '../data/profile.vi';
import publications from '../data/publications.json';
import { news } from '../data/news';
import { awards } from '../data/awards';
import { getLocale, localizePath, text } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = (en: string, vi: string) => text(locale, en, vi);
const path = (value: string) => localizePath(value, locale);
const projects = locale === 'vi' ? projectsVi : projectsEn;
const featuredPublications = [
  ...publications.filter(p => p.status === 'accepted'),
  ...publications.filter(p => p.status === 'published'),
];
const interests = [
  { label: t('Machine learning', 'Học máy'), topics: t('multimodal learning, graph neural networks, survival analysis', 'học đa phương thức, mạng nơ-ron đồ thị, phân tích sống còn') },
  { label: t('Biomedical research', 'Nghiên cứu y sinh'), topics: t('cancer research, computational genomics, RNA biology', 'nghiên cứu ung thư, hệ gen học tính toán, sinh học RNA') },
];
---
<Layout>
  <div class="container academic-shell">
    <div class="academic-main">
      <div class="home-overview-grid">
      <section class="academic-introduction" aria-labelledby="biography-title">
        <h2 id="biography-title">{t('About Me', 'Giới thiệu')}</h2>
        <p>{t('My research focuses on developing artificial intelligence methods for biomedicine, particularly graph learning and multimodal learning, to explore the relationships between molecular signals, tissue structure, and clinical outcomes. I aim to build AI models that are trustworthy, interpretable, and useful in practice, helping to bridge the gap between biological discovery and applications in precision medicine.', 'Tôi tập trung nghiên cứu và phát triển các phương pháp trí tuệ nhân tạo trong y sinh học, đặc biệt là học trên đồ thị và học đa phương thức, nhằm khám phá mối liên hệ giữa các tín hiệu phân tử, cấu trúc mô và kết cục lâm sàng. Mục tiêu của tôi là xây dựng những mô hình AI đáng tin cậy, có khả năng giải thích và mang lại giá trị thực tiễn, góp phần thu hẹp khoảng cách giữa các khám phá sinh học và ứng dụng trong y học chính xác.')}</p>
        <p>{t('I am currently conducting research in computational RNA biology with Professor Eduardo Eyras at the Centre for Computational Biomedical Sciences, John Curtin School of Medical Research, Australian National University. I am also a research collaborator at Hanoi Medical University, where I contribute to projects applying artificial intelligence to clinical research, particularly in oncology and obstetrics and gynaecology. This work focuses on developing and evaluating machine learning models to support data analysis and predict clinical outcomes.', 'Hiện tôi đang tham gia nghiên cứu về sinh học RNA tính toán cùng Giáo sư Eduardo Eyras tại Trung tâm Khoa học Y sinh Tính toán, Trường Nghiên cứu Y khoa John Curtin, Đại học Quốc gia Australia. Đồng thời, tôi là cộng tác viên nghiên cứu tại Trường Đại học Y Hà Nội, tham gia các dự án ứng dụng trí tuệ nhân tạo trong nghiên cứu y học lâm sàng, đặc biệt trong lĩnh vực ung thư và sản phụ khoa, với trọng tâm là phát triển và đánh giá các mô hình học máy hỗ trợ phân tích dữ liệu và dự báo kết quả lâm sàng.')}</p>
      </section>
      <section class="academic-section home-interests" aria-labelledby="interests-title">
        <h2 id="interests-title">{t('Research Interests', 'Hướng nghiên cứu')}</h2>
        <ul class="research-interest-list">{interests.map(interest=><li><strong>{interest.label}:</strong> {interest.topics}</li>)}</ul>
      </section>
      </div>
      <section class="academic-section home-news" id="news" aria-labelledby="news-title">
        <h2 id="news-title">{t('News', 'Tin mới')}</h2>
        <div class="news-scroll" tabindex="0" role="region" aria-label={t('Scrollable news', 'Tin mới có thể cuộn')}>
          <ul class="news-list">
            {news.map(item => <li id={`news-${item.id}`}>
              <strong class="news-date">[<time datetime={item.date}>{item.dateLabel[locale]}</time>]</strong>{' '}
              {item.before[locale]}<a href={path(item.link.href)}>{item.link.label[locale]}</a>{item.after[locale]}
            </li>)}
          </ul>
        </div>
      </section>
      <section class="academic-section academic-selected-publications" aria-labelledby="selected-title">
        <div class="academic-section-heading"><h2 id="selected-title">{t('Publications', 'Công bố tiêu biểu')}</h2><a class="text-link" href={path('/publications/')}>{t('All publications', 'Danh sách công bố')}</a></div>
        <div class="publication-list">{featuredPublications.map(paper=><Publication paper={paper} compact />)}</div>
        <p class="section-footnote">{t('† Equal contribution. Manuscripts under review are listed separately on the publications page.', '† Các tác giả có đóng góp ngang nhau. Bản thảo đang phản biện được trình bày riêng trong danh sách công bố.')}</p>
      </section>
      <section class="academic-section home-awards" id="awards" aria-labelledby="awards-title">
        <div class="academic-section-heading">
          <h2 id="awards-title">{t('Awards', 'Giải thưởng')}</h2>
          <a class="text-link" href={path('/about/#awards')}>{t('Details', 'Chi tiết')}</a>
        </div>
        <ul class="home-awards-list">
          {awards.map(award => <li>
            <strong class="award-year">[<time datetime={award.year}>{award.year}</time>]</strong>{' '}
            <a href={path(`/about/#${award.id}`)}>{award.title[locale]}</a> — {award.summary[locale]}
          </li>)}
        </ul>
      </section>
      <section class="academic-section" aria-labelledby="projects-title">
        <div class="academic-section-heading"><h2 id="projects-title">{t('Research Projects', 'Dự án nghiên cứu')}</h2><a class="text-link" href={path('/research/')}>{t('Project details', 'Chi tiết dự án')}</a></div>
        <ul class="home-project-list">{projects.map(project=><li><a href={path(`/research/${project.slug}/`)}>{project.short}</a> <span class="project-period">({project.period})</span></li>)}</ul>
      </section>
      <section class="academic-section academic-community-note" aria-labelledby="service-title"><h2 id="service-title">{t('Service', 'Hoạt động cộng đồng')}</h2><p>{t('Alongside research, I contribute to the Vietnamese student community in Australia through student leadership and organisational service.', 'Bên cạnh nghiên cứu, tôi tham gia công tác Hội và các hoạt động kết nối, đóng góp cho cộng đồng sinh viên Việt Nam tại Australia.')}</p><a class="text-link" href={path('/about/#community')}>{t('Leadership & public engagement', 'Công tác Hội và hoạt động cộng đồng')} <Icon size={15} /></a></section>
    </div>
  </div>
</Layout>
