---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import publications from '../data/publications.json';
import publicationTranslations from '../data/publications.vi.json';
import { profile } from '../data/profile';
import { news } from '../data/news';
import { awards } from '../data/awards';
import { education } from '../data/education';
import { researchExperience } from '../data/experience';
import { grants } from '../data/grants';
import { presentations } from '../data/presentations';
import { getLocale, localizePath, text } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const t = (en: string, vi: string) => text(locale, en, vi);
const path = (value: string) => localizePath(value, locale);
// At the author's request the manuscript under revision at Scientific Reports
// (M2, with its bioRxiv preprint) leads the list, marked as under revision,
// followed by the ACIIDS 2027 manuscript (M3, with its medRxiv preprint), marked
// as under review. Then come the accepted and published papers in CV order: conference papers first,
// then journal articles. At the author's request the homepage numbers them and
// sets each one like a CV publication list: the authors (my name in bold, † for
// equal contribution), the title in quotation marks, linked to the paper (its
// DOI or preprint DOI, else its project page, else its entry on the
// publications page), then
// the reference up to the year and, in brackets, the venue's rank where it has
// one ("CORE B" for a conference, "Q1, IF: 4.9" for a journal) and the status
// of a paper that is not yet published. Notes after the year (an
// ISBN, the article's language), PDFs and BibTeX are on the publications page.
type PublicationTranslation = { title?: string; citation?: string; note?: string };
const featuredPublications = [
  ...['M2', 'M3'].map(id => publications.find(p => p.id === id)!),
  ...['C', 'J'].flatMap(prefix => publications.filter(p => p.status !== 'review' && p.id.startsWith(prefix))),
].map(paper => {
  const translation = locale === 'vi' ? (publicationTranslations as Record<string, PublicationTranslation>)[paper.id] : undefined;
  const citation = (translation?.citation || paper.citation).replace(/\.$/, '');
  const year = String(paper.year);
  // The citation up to the year that ends its first sentence, so
  // "…, pp. 151–158, 2026. ISBN 978-…" becomes "…, pp. 151–158, 2026".
  const reference = citation.match(new RegExp(`^.*?\\b${year}(?=\\.\\s|$)`))?.[0] ?? (citation.includes(year) ? citation : `${citation}, ${year}`);
  const note = locale === 'vi' ? translation?.note : paper.note;
  const rank = (paper as { rank?: string }).rank;
  const brackets = [rank, note && `${note.charAt(0).toLowerCase()}${note.slice(1)}`].filter(Boolean).join('; ');
  const doi = paper.links.find(link => link.url.startsWith('https://doi.org/'))?.url;
  return {
    authors: paper.authors.map(name => ({ name, self: name === 'B. M. Tran', equal: paper.equalContribution.includes(name) })),
    title: translation?.title || paper.title,
    titleLang: locale === 'vi' && !translation?.title ? 'en' : undefined,
    href: doi ?? (paper.project ? path(`/research/${paper.project}/`) : `${path('/publications/')}#paper-${paper.id}`),
    external: Boolean(doi),
    reference: `${reference}${brackets ? ` (${brackets})` : ''}.`,
    referenceLang: locale === 'vi' && !translation?.citation ? 'en' : undefined,
  };
});
const hasEqualContribution = featuredPublications.some(paper => paper.authors.some(author => author.equal));
// Month dates for News and Presentations: "Nov 2026" in English and "11/2026"
// in Vietnamese, like the other dated sections.
const monthsEn = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const monthYear = (iso: string) => {
  const [year, month] = iso.split('-');
  return locale === 'vi' ? `${month}/${year}` : `${monthsEn[Number(month) - 1]} ${year}`;
};
// Research interests as one plain bulleted list (no bold, one indent). The
// English is the author's own five-item list (revised 25 November 2026). The
// Vietnamese keeps the author's own wording for items three and four. The first
// two items join the author's earlier Vietnamese phrases, with "phân tích ảnh y
// tế" (medical image analysis) translated; the last item is translated from the
// revised English.
const interests = [
  t('Biomedical AI, multimodal learning, and graph representation learning', 'Trí tuệ nhân tạo trong y sinh học, học đa phương thức và học biểu diễn đồ thị'),
  t('Medical image analysis, computational pathology, and spatial omics', 'Phân tích ảnh y tế, giải phẫu bệnh học tính toán và phân tích omics không gian'),
  t('Computational RNA biology and epitranscriptomics', 'Sinh học RNA tính toán và biểu sinh RNA'),
  t('Computational genomics and genetic variant interpretation', 'Hệ gen học tính toán và diễn giải biến thể di truyền'),
  t('Cancer biomarker discovery and clinical outcome prediction', 'Phát hiện dấu ấn sinh học ung thư và dự đoán kết cục lâm sàng'),
];
// Structured data (schema.org JSON-LD) for search engines. Google reads a
// personal "About me" page as a profile page (ProfilePage) about one person, and
// reads the site name from WebSite data on the root home page only, so the
// English home page carries both and the Vietnamese one the profile alone. Each
// value repeats what the page shows: the name in the heading (the other
// language's form is the alternate name), the portrait, the visiting appointment
// shown in the sidebar and under Research Experience, the bachelor's degree under
// Education, the research interests and the profile links in the sidebar.
const site = Astro.site ?? Astro.url;
const home = new URL('/', site).href;
const appointment = researchExperience.find(item => item.id === 'anu-visiting')!;
const bachelor = education.find(item => item.id === 'bachelor-sydney')!;
const person = {
  '@type': 'Person',
  '@id': `${home}#person`,
  name: t(profile.name, 'Trần Bình Minh'),
  alternateName: t('Trần Bình Minh', profile.name),
  url: home,
  image: new URL('/assets/binh-minh-tran-avatar.jpg', site).href,
  description: [appointment.role, appointment.unit!, appointment.organisation].map(part => part[locale]).join(', '),
  jobTitle: appointment.role[locale],
  affiliation: {
    '@type': 'Organization',
    name: appointment.unit![locale],
    parentOrganization: { '@type': 'CollegeOrUniversity', name: appointment.organisation[locale] },
  },
  alumniOf: { '@type': 'CollegeOrUniversity', name: bachelor.institution[locale] },
  knowsAbout: interests,
  sameAs: [profile.scholar, profile.orcid, profile.researchgate, profile.linkedin],
};
const structuredData = [
  ...(locale === 'en' ? [{ '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${home}#website`, name: profile.name, alternateName: ['Trần Bình Minh'], url: home }] : []),
  { '@context': 'https://schema.org', '@type': 'ProfilePage', url: new URL(path('/'), site).href, inLanguage: locale, mainEntity: person },
];
---
<Layout structuredData={structuredData}>
  <div class="container academic-shell">
    <div class="academic-main">
      <div class="home-overview-grid">
      <section class="academic-introduction" aria-labelledby="biography-title">
        <h2 id="biography-title">{t('About Me', 'Giới thiệu')}</h2>
        {/* The bio opens, as academic homepages do, with the current position, the project (described as the host suggested and as the CV does), the planned doctorate and the first degree. The research focus and the Hanoi collaboration are the author's own sentences, and the Vietnamese text is the author's own translation. At the author's request it does not name supervisors. */}
        <p>{t('I am a Visiting Researcher at the Centre for Computational Biomedical Sciences, John Curtin School of Medical Research, Australian National University (ANU), where I work on computational biology. I am investigating how multimodal deep learning can incorporate epitranscriptomic evidence into genetic variant interpretation. I plan to begin my Ph.D. at ANU in 2027. Before that, I completed a Bachelor of Advanced Computing (Honours) at the University of Sydney.', 'Hiện tôi là nghiên cứu viên khách mời tại Trung tâm Khoa học Y sinh Tính toán, thuộc Trường Nghiên cứu Y khoa John Curtin, Đại học Quốc gia Australia (ANU). Tại đây, tôi nghiên cứu sinh học bằng các phương pháp tính toán. Tôi đang nghiên cứu cách ứng dụng học sâu đa phương thức để tích hợp bằng chứng về các biến đổi hóa học trên RNA vào quá trình diễn giải ý nghĩa của các biến thể di truyền. Tôi dự kiến bắt đầu chương trình tiến sĩ tại ANU vào năm 2027. Trước đó, tôi đã hoàn thành chương trình Cử nhân Khoa học Máy tính nâng cao (Honours) tại Đại học Sydney.')}</p>
        <p>{t('My research focuses on developing artificial intelligence methods for biomedicine, particularly graph learning and multimodal learning, to explore the relationships between molecular signals, tissue structure, and clinical outcomes. I aim to build AI models that are trustworthy, interpretable, and useful in practice, helping to bridge the gap between biological discovery and applications in precision medicine.', 'Nghiên cứu của tôi tập trung vào việc phát triển các phương pháp trí tuệ nhân tạo phục vụ y sinh học, đặc biệt là học trên đồ thị và học đa phương thức, nhằm khám phá mối liên hệ giữa tín hiệu phân tử, cấu trúc mô và kết cục lâm sàng. Tôi hướng tới xây dựng các mô hình AI đáng tin cậy, có thể diễn giải và có giá trị ứng dụng thực tiễn, góp phần thu hẹp khoảng cách giữa những khám phá sinh học và ứng dụng trong y học chính xác.')}</p>
        <p>{t('I am also a research collaborator at Hanoi Medical University, where I contribute to projects applying artificial intelligence to clinical research, particularly in oncology and obstetrics and gynaecology. This work focuses on developing and evaluating machine learning models to support data analysis and predict clinical outcomes.', 'Bên cạnh đó, tôi là cộng tác viên nghiên cứu tại Trường Đại học Y Hà Nội, tham gia các dự án ứng dụng trí tuệ nhân tạo trong nghiên cứu lâm sàng, đặc biệt trong lĩnh vực ung bướu và sản phụ khoa. Công việc của tôi tập trung vào việc phát triển và đánh giá các mô hình học máy nhằm hỗ trợ phân tích dữ liệu và dự đoán kết cục lâm sàng.')}</p>
      </section>
      <section class="academic-section home-education" id="education" aria-labelledby="education-title">
        <h2 id="education-title">{t('Education', 'Học vấn')}</h2>
        <ul class="cv-list home-education-list" role="list">
          {education.map(item => <li>
            <span class="entry-date">{item.period[locale]}</span>
            <div class="entry-body">
              <span class="entry-line"><strong>{item.degree[locale]}</strong>, {item.institution[locale]}</span>
              {item.field && <span class="entry-detail">{item.field[locale]}</span>}
              {item.thesis && <span class="entry-detail">{t('Thesis', 'Luận văn')}: <a href={item.thesis.href} target="_blank" rel="noopener noreferrer" lang="en"><em>{item.thesis.title}</em></a> (PDF)</span>}
            </div>
          </li>)}
        </ul>
      </section>
      <section class="academic-section home-interests" aria-labelledby="interests-title">
        <h2 id="interests-title">{t('Research Interests', 'Hướng nghiên cứu')}</h2>
        <ul class="research-interest-list">{interests.map(interest => <li>{interest}</li>)}</ul>
      </section>
      </div>
      <section class="academic-section home-news" id="news" aria-labelledby="news-title">
        <h2 id="news-title">{t('News', 'Tin mới')}</h2>
        <div class="news-scroll" tabindex="0" role="region" aria-label={t('Scrollable news', 'Tin mới có thể cuộn')}>
          <ul class="cv-list news-list" role="list">
            {news.map(item => <li id={`news-${item.id}`}>
              <time class="entry-date" datetime={item.date}>{monthYear(item.date)}</time>
              <div class="entry-body">{item.before[locale]}<a href={path(item.link.href)}>{item.link.label[locale]}</a>{item.after[locale]}</div>
            </li>)}
          </ul>
        </div>
      </section>
      <section class="academic-section academic-selected-publications" aria-labelledby="selected-title">
        <div class="academic-section-heading"><h2 id="selected-title">{t('Publications', 'Công bố tiêu biểu')}</h2><a class="text-link" href={path('/publications/')}>{t('All publications', 'Danh sách công bố')}</a></div>
        <ol class="selected-publication-list">
          {featuredPublications.map(paper => <li>{paper.authors.map((author, i) => <>{i > 0 && ', '}<span class="nowrap">{author.self ? <strong>{author.name}</strong> : author.name}{author.equal && <sup>†</sup>}</span></>)}, “<a href={paper.href} target={paper.external ? '_blank' : undefined} rel={paper.external ? 'noopener noreferrer' : undefined} lang={paper.titleLang}>{paper.title}</a>”, <span lang={paper.referenceLang}>{paper.reference}</span></li>)}
        </ol>
        {hasEqualContribution && <p class="selected-publication-note">{t('† Equal contribution.', '† Các tác giả có đóng góp ngang nhau.')}</p>}
        <p class="selected-publication-more"><a class="text-link" href={profile.scholar} target="_blank" rel="noopener noreferrer"><Icon name="arrow" size={15} />{t('Full list on Google Scholar', 'Danh sách đầy đủ trên Google Scholar')}</a></p>
      </section>
      <section class="academic-section home-experience" id="experience" aria-labelledby="experience-title">
        <h2 id="experience-title">{t('Research Experience', 'Kinh nghiệm nghiên cứu')}</h2>
        <ul class="cv-list home-experience-list" role="list">
          {researchExperience.map(item => <li>
            <span class="entry-date">{item.period[locale]}</span>
            <div class="entry-body">
              {item.unit
                ? <><span class="entry-line"><strong>{item.role[locale]}</strong>, {item.unit[locale]},</span><span class="entry-line">{item.organisation[locale]}, {item.location[locale]}</span></>
                : <span class="entry-line"><strong>{item.role[locale]}</strong>, {item.organisation[locale]}, {item.location[locale]}</span>}
            </div>
          </li>)}
        </ul>
      </section>
      <section class="academic-section home-grants" id="grants" aria-labelledby="grants-title">
        <h2 id="grants-title">{t('Research Grants', 'Tài trợ nghiên cứu')}</h2>
        <ul class="cv-list home-grants-list" role="list">
          {grants.map(grant => <li>
            <span class="entry-date">{grant.period?.[locale]}</span>
            <div class="entry-body">
              <span class="entry-line"><strong>{grant.funder[locale]}</strong>, {grant.scheme[locale]}</span>
              {grant.project && <em class="entry-title">{grant.project[locale].split(' ').map((word, i) => <>{i > 0 && ' '}{word.includes('-') ? <span class="nowrap">{word}</span> : word}</>)}</em>}
              {(grant.role || grant.amount) && <span class="entry-detail">{[grant.role && `${t('Role', 'Vai trò')}: ${grant.role[locale]}`, grant.amount && `${t('Amount', 'Kinh phí')}: ${grant.amount[locale]}`].filter(Boolean).join(' · ')}</span>}
            </div>
          </li>)}
        </ul>
      </section>
      <section class="academic-section home-presentations" id="presentations" aria-labelledby="presentations-title">
        <h2 id="presentations-title">{t('Presentations', 'Báo cáo khoa học')}</h2>
        <ul class="cv-list home-presentations-list" role="list">
          {presentations.map(item => <li>
            <time class="entry-date" datetime={item.date}>{monthYear(item.date)}</time>
            <div class="entry-body">
              <span class="entry-line"><strong>{item.type[locale]}</strong>{item.language && ` (${item.language[locale]})`}, {item.event[locale]},</span>
              <span class="entry-line">{item.venue[locale]}</span>
              <em class="entry-title">{item.href ? <a href={path(item.href)}>{item.title[locale]}</a> : item.title[locale]}</em>
            </div>
          </li>)}
        </ul>
      </section>
      <section class="academic-section home-awards" id="awards" aria-labelledby="awards-title">
        <h2 id="awards-title">{t('Honours and Awards', 'Giải thưởng và danh hiệu')}</h2>
        <ul class="cv-list home-awards-list" role="list">
          {awards.map(award => <li>
            <time class="entry-date" datetime={award.year}>{award.year}</time>
            <div class="entry-body"><span class="entry-line"><strong>{award.title[locale]}</strong>, {(award.organisationShort ?? award.organisation)[locale]}</span></div>
          </li>)}
        </ul>
      </section>
    </div>
  </div>
</Layout>
