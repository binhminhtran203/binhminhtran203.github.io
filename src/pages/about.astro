---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import AcademicProfile from '../components/AcademicProfile.astro';
import { profile } from '../data/profile';
import { researchStory, leadership, media } from '../data/community';
const experience = [
  {date:'Oct 2026 — present',role:'Visiting Researcher',institution:'Australian National University',detail:'Centre for Computational Biomedical Sciences, John Curtin School of Medical Research. Preliminary work on computational RNA biology and AI/ML interpretation of genetic variants affecting RNA modifications.',supervisor:'Research host: Professor Eduardo Eyras'},
  {date:'Feb — Oct 2026',role:'Honours Research Student',institution:'The University of Sydney',detail:'Designed NIMSurv, a hierarchical graph model combining clinical data and imaging mass cytometry for breast cancer survival prediction.',supervisor:'Supervisor: Associate Professor Xiuying Wang'},
  {date:'Dec 2025 — present',role:'Research Collaborator',institution:'Hanoi Medical University',detail:'Multimodal and multitask learning for breast cancer receptor status prediction, integrating clinical variables, H&E whole-slide images, and RNA-seq.'},
  {date:'Dec 2025 — Mar 2026',role:'Research Assistant',institution:'Vietnam Academy of Science and Technology',detail:'Reproducible NGS preprocessing and annotation workflows for mutation and microbial gene-function analyses.'},
  {date:'Dec 2024 — Dec 2025',role:'Research Collaborator',institution:'Hanoi University of Industry',detail:'Variational multi-view and dual-stream contrastive graph models for lncRNA–disease association prediction.',supervisor:'Supervisor: Associate Professor Dang Hung Tran'},
];
const awards = [
  {year:'2026',title:'AURORA Scientific Research Awards',detail:'Top 10 finalist · Vietnam–Australia Innovation Network (NIC-AU). Grand Final scheduled for December 2026.'},
  {year:'2026',title:'Outstanding Student Award',detail:'Embassy of Vietnam in Australia · Academic and research achievement.'},
  {year:'2026',title:'Vietnamese Young Intellectuals Forum in Australia',detail:'Second Prize · Breast cancer receptor-status research.'},
  {year:'2026',title:'Youth Science and Technology Conference',detail:'Third Prize · Hanoi Medical University; selected for the 23rd Youth Science and Technology Conference of the Vietnamese Health Sector.'},
  {year:'2025',title:'January Star Award',detail:'Vietnam National Union of Students · Academic achievement, research, and student leadership.'},
];
---
<Layout title="About & CV" description="Academic background, research experience, selected awards, and curriculum vitae of Binh Minh Tran.">
  <div class="container academic-shell about-shell">
    <AcademicProfile />
    <section class="academic-main biography-section" aria-labelledby="about-title">
      <p class="academic-kicker">Biography & research motivation</p>
      <h1 id="about-title">About</h1>
      <nav class="about-sections-nav" aria-label="On this page"><a href="#education">Education</a><a href="#experience">Experience</a><a href="#community">Community</a><a href="#media">Media</a><a href="#awards">Awards</a></nav>
      <div class="biography-text">{researchStory.map(paragraph=><p class="about-bio">{paragraph}</p>)}</div>
      <a class="text-link biography-cv" href={profile.cv} download>Download curriculum vitae <Icon name="download" size={16} /></a>
    </section>
  </div>
  <section class="container about-section" id="education"><div class="about-section-label"><h2>Education</h2></div><div class="timeline"><article class="timeline-entry"><span class="timeline-date">2023 — present</span><h3>Bachelor of Advanced Computing (Honours)</h3><p class="institution">The University of Sydney</p><p>Computational Data Science · Expected completion: December 2026</p><p class="small-note">Honours thesis: Multimodal Breast Cancer Survival Prediction with Hierarchical Niche–Interface Graph Learning. Supervisor: Associate Professor Xiuying Wang.</p></article><article class="timeline-entry upcoming-entry"><span class="badge badge-review">Prospective · 2027 — 2031</span><h3>Doctor of Philosophy, Medical Science</h3><p class="institution">Australian National University</p><p>Planned doctoral research in computational RNA biology with Professor Eduardo Eyras.</p><p class="small-note">Supervision and MACSYS scholarship funding confirmed in writing, subject to formal PhD admission.</p></article><article class="timeline-entry"><span class="timeline-date">2019 — 2022</span><h3>Specialised Physics Programme</h3><p class="institution">HUS High School for Gifted Students</p><p>VNU University of Science, Vietnam National University, Hanoi.</p></article></div></section>
  <section class="container about-section" id="experience"><div class="about-section-label"><h2>Experience</h2></div><div class="timeline">{experience.map(item=><article class="timeline-entry"><span class="timeline-date">{item.date}</span><h3>{item.role}</h3><p class="institution">{item.institution}</p><p>{item.detail}</p>{item.supervisor && <p class="small-note">{item.supervisor}</p>}</article>)}<article class="timeline-entry"><span class="timeline-date">Dec 2024 — Mar 2025</span><h3>Data Engineer Intern</h3><p class="institution">Viettel Software</p><p>Built and maintained Python/SQL ETL pipelines for operational datasets. Implemented data-quality checks, contributed to schema design and technical documentation, and optimised queries and pipeline performance for downstream analytics.</p></article><article class="timeline-entry"><span class="timeline-date">Jun — Jul 2024</span><h3>Data Engineer Intern</h3><p class="institution">Agribank</p><p>Supported ETL of banking datasets into internal reporting systems, prepared structured operational datasets, and contributed to dashboards and reports for internal stakeholders.</p></article></div></section>
  <section class="community-section" id="community"><div class="container"><div class="section-heading"><div><h2>Leadership & service</h2></div><p class="section-intro">Alongside research, I contribute to the Vietnamese student community in Australia through student leadership and organisational service. I value the connections between academic life, professional development, and community.</p></div><div class="leadership-grid">{leadership.map(item=><article class="leadership-card"><div class="leadership-card-top"><span class="eyebrow">Student leadership</span><span class:list={['badge',{'badge-review':item.status==='Previous'}]}>{item.status}</span></div><h3>{item.role}</h3><p class="leadership-organisation">{item.organisation}</p><p class="small-note">{item.period}</p></article>)}</div><div class="community-source"><a class="text-link" href={profile.linkedin} target="_blank" rel="noopener noreferrer">More on LinkedIn <Icon name="external" size={15} /></a></div></div></section>
  <section class="container media-section" id="media"><div class="section-heading section-heading-inline"><div><h2>Media & engagement</h2></div><span class="small-note">Research, student life & community</span></div><div class="media-grid">{media.map(item=><article class="media-card"><div class="media-card-meta"><span class="media-outlet">{item.outlet}</span><span>{item.kind}</span></div><h3>{item.title}</h3><p>{item.description}</p><a class="text-link" href={item.url} target="_blank" rel="noopener noreferrer">{item.linkLabel} <Icon name="external" size={16} /></a></article>)}</div></section>
  <section class="skills-section"><div class="container"><h2>Research methods & tools</h2><div class="skills-grid"><div><h3>Build</h3><p>Python · R · SQL · Bash<br />PyTorch · PyTorch Geometric · scikit-learn<br />Git · Linux · LaTeX</p></div><div><h3>Model</h3><p>Graph neural networks · Multimodal fusion<br />Multiple-instance & contrastive learning<br />Cox & discrete-time survival models</p></div><div><h3>Evaluate</h3><p>Patient-level nested cross-validation<br />Bootstrap confidence intervals · Calibration<br />External validation · Experiment tracking</p></div></div></div></section>
  <section class="container about-section awards-section" id="awards"><div class="about-section-label"><h2>Selected awards</h2></div><div>{awards.map(award=><article class="award-entry"><span>{award.year}</span><div><h3>{award.title}</h3><p>{award.detail}</p></div></article>)}<p class="small-note awards-footnote">Sydney International Student Award recipient since 2023. Full scholarship and award details are available in my CV.</p></div></section>
</Layout>
