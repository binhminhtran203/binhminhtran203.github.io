---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Publication from '../components/Publication.astro';
import publications from '../data/publications.json';
import { profile } from '../data/profile';
const published = publications.filter(p=>p.status==='published').length;
const review = publications.filter(p=>p.status==='review').length;
---
<Layout title="Publications" description="Publications and manuscripts by Binh Minh Tran on multimodal learning, graph neural networks, RNA-disease associations, and computational oncology.">
  <section class="page-header container"><p class="academic-kicker">Research output</p><h1>Publications & manuscripts</h1><div class="publication-header-bottom"><p class="page-lead">Peer-reviewed publications and manuscripts under review. My name is in bold; † indicates equal contribution.</p><a class="text-link" href={profile.scholar} target="_blank" rel="noopener noreferrer">Google Scholar <Icon name="external" /></a></div></section>
  <section class="container publication-section">
    <div class="publication-toolbar"><div class="filter-group" role="group" aria-label="Filter publications by status"><button type="button" data-filter="all" aria-pressed="true">All work <span>{publications.length}</span></button><button type="button" data-filter="published" aria-pressed="false">Published <span>{published}</span></button><button type="button" data-filter="review" aria-pressed="false">Under review <span>{review}</span></button></div><label class="search-box"><Icon name="search" size={17} /><span class="sr-only">Search publications by title, author, venue, or topic</span><input id="publication-search" type="search" placeholder="Search publications…" autocomplete="off" /></label></div>
    <div class="publication-results"><span id="result-count" role="status" aria-live="polite">Showing all {publications.length} works</span><span>Updated October 2026</span></div>
    <div class="publication-list" id="publication-list">
      <section class="publication-group" data-publication-group="published" aria-labelledby="published-papers-title">
        <h2 id="published-papers-title">Published papers</h2>
        {publications.filter(paper=>paper.status==='published').map(paper=><Publication paper={paper} />)}
      </section>
      <section class="publication-group" data-publication-group="review" aria-labelledby="review-manuscripts-title">
        <h2 id="review-manuscripts-title">Manuscripts under review</h2>
        {publications.filter(paper=>paper.status==='review').map(paper=><Publication paper={paper} />)}
      </section>
    </div>
    <div class="empty-state" hidden><p class="eyebrow">No matches</p><h2>Try another search.</h2><p>Search by a title, author, venue, or research topic.</p><button class="button button-primary" id="reset-filters" type="button">Clear search & filters <Icon /></button></div>
    <p class="section-footnote">Under review indicates an active submission, not an accepted publication. The HiNT-Surv manuscript targets CIHM at SSCI 2027; its record is dated 2026.</p>
    <p class="sr-only" id="clipboard-status" aria-live="polite"></p>
  </section>
  <script>
    const search = document.querySelector<HTMLInputElement>('#publication-search');
    const papers = [...document.querySelectorAll<HTMLElement>('#publication-list .publication')];
    const groups = [...document.querySelectorAll<HTMLElement>('#publication-list .publication-group')];
    const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const count = document.querySelector('#result-count');
    const empty = document.querySelector<HTMLElement>('.empty-state');
    let selected = 'all';
    function updateResults() {
      const query = search?.value.trim().toLowerCase() || '';
      let visible = 0;
      papers.forEach(paper => {
        const matches = (selected === 'all' || paper.dataset.status === selected) && (!query || paper.dataset.search?.includes(query));
        paper.hidden = !matches;
        if (matches) visible++;
      });
      groups.forEach(group => { group.hidden = !group.querySelector('.publication:not([hidden])'); });
      if (count) count.textContent = `Showing ${visible} of ${papers.length} works`;
      if (empty) empty.hidden = visible !== 0;
      filters.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.filter === selected)));
    }
    filters.forEach(button=>button.addEventListener('click',()=>{ selected=button.dataset.filter||'all'; updateResults(); }));
    search?.addEventListener('input',updateResults);
    document.querySelector('#reset-filters')?.addEventListener('click',()=>{ selected='all'; if(search)search.value=''; updateResults(); search?.focus(); });
    document.querySelectorAll<HTMLButtonElement>('.copy-bibtex').forEach(button=>button.addEventListener('click',async()=>{ const label=button.querySelector('span'); const status=document.querySelector('#clipboard-status'); try { await navigator.clipboard.writeText(button.dataset.bibtex||''); if(label)label.textContent='Copied'; if(status)status.textContent='BibTeX citation copied to clipboard.'; setTimeout(()=>{if(label)label.textContent='Copy BibTeX';},2200); } catch { const details=button.closest('.pub-body')?.querySelector('details'); if(details)details.open=true; if(status)status.textContent='Clipboard unavailable. The citation is open below for manual copying.'; } }));
  </script>
</Layout>
