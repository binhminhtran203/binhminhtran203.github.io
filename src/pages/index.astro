---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import AcademicProfile from '../components/AcademicProfile.astro';
import Publication from '../components/Publication.astro';
import { projects } from '../data/profile';
import publications from '../data/publications.json';
const interests = ['Multimodal learning', 'Graph neural networks', 'Survival analysis', 'Cancer research', 'Computational genomics', 'RNA biology'];
---
<Layout>
  <div class="container academic-shell">
    <AcademicProfile />
    <div class="academic-main">
      <section class="academic-introduction" aria-labelledby="biography-title">
        <h2 id="biography-title">Research overview</h2>
        <p>My research focuses on graph and multimodal learning for biomedical applications, connecting molecular signals, tissue organisation, and patient outcomes. I aim to develop trustworthy, interpretable AI methods that connect biological discovery with precision medicine.</p>
        <p>At the Australian National University, I am undertaking preliminary research in computational RNA biology with Professor Eduardo Eyras at the Centre for Computational Biomedical Sciences, John Curtin School of Medical Research.</p>
        <a class="text-link" href="/about/">Biography and academic background</a>
      </section>
      <section class="academic-section" aria-labelledby="interests-title">
        <h2 id="interests-title">Research interests</h2>
        <ul class="research-interest-list">{interests.map(interest=><li>{interest}</li>)}</ul>
      </section>
      <section class="academic-section academic-selected-publications" aria-labelledby="selected-title">
        <div class="academic-section-heading"><h2 id="selected-title">Selected publications</h2><a class="text-link" href="/publications/">All publications</a></div>
        <div class="publication-list">{publications.filter(p=>p.status==='published').map(paper=><Publication paper={paper} compact />)}</div>
        <p class="section-footnote">† Equal contribution. Manuscripts under review are listed separately on the publications page.</p>
      </section>
      <section class="academic-section" aria-labelledby="projects-title">
        <div class="academic-section-heading"><h2 id="projects-title">Research projects</h2><a class="text-link" href="/research/">Project details</a></div>
        <div class="research-summaries">{projects.map(project=><article><div class="research-summary-heading"><h3><a href={`/research/${project.slug}/`}>{project.short}</a></h3><span>{project.period}</span></div><p>{project.description}</p></article>)}</div>
      </section>
      <section class="academic-section academic-community-note" aria-labelledby="service-title"><h2 id="service-title">Academic & community engagement</h2><p>Alongside research, I contribute to the Vietnamese student community in Australia through student leadership and organisational service.</p><a class="text-link" href="/about/#community">Leadership & public engagement <Icon size={15} /></a></section>
    </div>
  </div>
</Layout>
